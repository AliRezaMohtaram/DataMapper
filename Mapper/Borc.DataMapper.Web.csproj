<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Filters\" />
    <Folder Include="Middleware\" />
    <Folder Include="Extensions\" />
    <Folder Include="Areas\" />
  </ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Borc.DataMapper.Application\Borc.DataMapper.Application.csproj" />
		<ProjectReference Include="..\Borc.DataMapper.Infrastructure\Borc.DataMapper.Infrastructure.csproj" />
		<ProjectReference Include="..\Borc.Users.Web\Borc.Users.Web.csproj" />
	</ItemGroup>
	

	<!--
		OrgChart (github.com/AliRezaMohtaram/organization) and Acl (github.com/AliRezaMohtaram/Acl) come as NuGet packages.
		Until they are on a shared feed they are restored from local folders: by default the clones next to this repository
		(../organization and ../Acl) after "dotnet pack <sln> -c Release" in each. Override with the OrgChartPackages /
		AclPackages properties or environment variables.
	-->
	<PropertyGroup>
		<OrgChartPackages Condition="'$(OrgChartPackages)' == ''">$(MSBuildThisFileDirectory)..\..\organization\artifacts\packages</OrgChartPackages>
		<AclPackages Condition="'$(AclPackages)' == ''">$(MSBuildThisFileDirectory)..\..\Acl\artifacts\packages</AclPackages>
		<RestoreAdditionalProjectSources Condition="Exists('$(OrgChartPackages)')">$(RestoreAdditionalProjectSources);$(OrgChartPackages)</RestoreAdditionalProjectSources>
		<RestoreAdditionalProjectSources Condition="Exists('$(AclPackages)')">$(RestoreAdditionalProjectSources);$(AclPackages)</RestoreAdditionalProjectSources>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="OrgChart.AspNetCore" Version="0.1.0" />
		<PackageReference Include="OrgChart.EFCore" Version="0.1.0" />
		<PackageReference Include="OrgChart.Razor" Version="0.1.0" />
		<PackageReference Include="OrgChart.Acl" Version="0.1.0" />
		<PackageReference Include="Acl.AspNetCore" Version="0.3.0" />
		<PackageReference Include="Acl.EFCore" Version="0.3.0" />
		<PackageReference Include="Acl.Razor" Version="0.3.0" />
	</ItemGroup>

</Project>
