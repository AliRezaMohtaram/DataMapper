@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();

    // هر تب = یک Controller. با ساخته شدن بخش‌های بعدی، همین‌جا اضافه کنید.
    var tabs = new (string Controller, string Label)[]
    {
        ("Templates", "۱. طراحی قالب پایه"),
        // ("Mapping",   "۲. معادل‌سازی و خروجی"),
        // ("Entry",     "۳. فرم ورود دستی داده"),
        // ("Layouts",   "۴. طراح Layout فرم"),
    };
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Data Mapper</title>
    <link rel="stylesheet" href="~/css/theme.css" />

    <!-- اعمال تم ذخیره‌شده پیش از اولین رندر (جلوگیری از پرش رنگ) -->
    <script>
        (function () {
            try {
                var t = JSON.parse(localStorage.getItem("app-theme") || "{}");
                var r = document.documentElement;
                r.dataset.theme  = t.mode   || "dark";
                r.dataset.preset = t.preset || "ocean-dark";
                r.dataset.accent = t.accent || "cyan";
                r.dataset.size   = t.size   || "medium";
                r.dataset.radius = t.radius || "medium";
            } catch (e) { }
        })();
    </script>

    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="wrap">

        <!-- هدر -->
        <header class="top">
            <div class="brand">
                <div class="logo"><b>M</b><i>v2.2</i></div>
                <div>
                    <h1>Data Mapper</h1>
                    <p>سامانه هوشمند معادل‌سازی و اعتبارسنجی داده‌های سازمانی</p>
                </div>
            </div>



    <div class="header-left">

        <button
            class="header-icon-btn"
            id="openThemeSettings"
            title="تنظیمات ظاهر"
            aria-label="تنظیمات ظاهر">

            <svg
                width="19"
                height="19"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8">

                <path d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z"/>

                <path d="
                    M19.4 15a1.7 1.7 0 0 0
                    .34 1.88l.06.06-1.7 1.7-.06-.06
                    a1.7 1.7 0 0 0-1.88-.34
                    1.7 1.7 0 0 0-1.03 1.56V20h-2.4v-.2
                    a1.7 1.7 0 0 0-1.03-1.56
                    1.7 1.7 0 0 0-1.88.34l-.06.06
                    -1.7-1.7.06-.06A1.7 1.7 0 0 0
                    8.46 15 1.7 1.7 0 0 0 6.9 14H6.7v-2.4h.2
                    A1.7 1.7 0 0 0 8.46 10
                    1.7 1.7 0 0 0 8.12 8.12l-.06-.06
                    1.7-1.7.06.06A1.7 1.7 0 0 0
                    11.7 6.08V5.9h2.4v.2
                    a1.7 1.7 0 0 0 1.03 1.56
                    1.7 1.7 0 0 0 1.88-.34l.06-.06
                    1.7 1.7-.06.06A1.7 1.7 0 0 0
                    18.4 10c.17.62.72 1.1 1.36 1.1h.2v2.4h-.2
                    A1.7 1.7 0 0 0 19.4 15Z"/>

            </svg>

        </button>

    </div>

            <form class="search" method="get" asp-controller="Templates" asp-action="Index" role="search">
                <label for="globalSearch"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg></label>
                <input type="text" id="globalSearch" name="search" placeholder="جستجوی سریع در قالب‌ها..." autocomplete="off">
                <kbd>Ctrl + K</kbd>
            </form>
        </header>

        <!-- تنظیمات ظاهر -->
        <div class="theme-overlay" id="themeOverlay"></div>

<aside
    class="theme-drawer"
    id="themeDrawer"
    aria-hidden="true">

    <div class="theme-drawer-header">

        <div>
            <h3>تنظیمات ظاهر</h3>
            <p>محیط کاربری را مطابق سلیقه خود تنظیم کنید.</p>
        </div>

        <button
            class="theme-close"
            id="closeThemeSettings"
            aria-label="بستن">

            ×

        </button>

    </div>


    <div class="theme-drawer-body">

        <!-- MODE -->

        <section class="theme-section">

            <div class="theme-section-title">
                حالت نمایش
            </div>

            <div class="theme-mode">

                <button data-mode="light">
                    <span class="theme-option-icon">☀</span>
                    <span>روشن</span>
                </button>

                <button data-mode="dark">
                    <span class="theme-option-icon">☾</span>
                    <span>تیره</span>
                </button>

                <button data-mode="system">
                    <span class="theme-option-icon">◐</span>
                    <span>سیستم</span>
                </button>

            </div>

        </section>


        <!-- PRESETS -->

        <section class="theme-section">

            <div class="theme-section-title">
                قالب آماده
            </div>

            <div class="theme-presets">

                <button
                    class="preset"
                    data-preset-select="ocean-dark">

                    <span
                        class="preset-preview ocean">
                    </span>

                    <span>
                        Ocean Dark
                    </span>

                </button>


                <button
                    class="preset"
                    data-preset-select="midnight">

                    <span
                        class="preset-preview midnight">
                    </span>

                    <span>
                        Midnight
                    </span>

                </button>


                <button
                    class="preset"
                    data-preset-select="graphite">

                    <span
                        class="preset-preview graphite">
                    </span>

                    <span>
                        Graphite
                    </span>

                </button>


                <button
                    class="preset"
                    data-preset-select="arctic-light">

                    <span
                        class="preset-preview arctic">
                    </span>

                    <span>
                        Arctic Light
                    </span>

                </button>


                <button
                    class="preset"
                    data-preset-select="emerald">

                    <span
                        class="preset-preview emerald">
                    </span>

                    <span>
                        Emerald
                    </span>

                </button>


                <button
                    class="preset"
                    data-preset-select="royal-blue">

                    <span
                        class="preset-preview royal">
                    </span>

                    <span>
                        Royal Blue
                    </span>

                </button>

            </div>

        </section>


        <!-- ACCENT -->

        <section class="theme-section">

            <div class="theme-section-title">
                رنگ اصلی
            </div>

            <div class="accent-list">

                <button
                    data-accent-select="cyan"
                    style="--accent:#3bffcb">
                </button>

                <button
                    data-accent-select="blue"
                    style="--accent:#4dabf7">
                </button>

                <button
                    data-accent-select="purple"
                    style="--accent:#b197fc">
                </button>

                <button
                    data-accent-select="orange"
                    style="--accent:#ff922b">
                </button>

                <button
                    data-accent-select="pink"
                    style="--accent:#f783ac">
                </button>

            </div>

        </section>


        <!-- SIZE -->

        <section class="theme-section">

            <div class="theme-section-title">
                اندازه رابط کاربری
            </div>

            <div class="theme-select">

                <button data-size-select="small">
                    کوچک
                </button>

                <button data-size-select="medium">
                    متوسط
                </button>

                <button data-size-select="large">
                    بزرگ
                </button>

            </div>

        </section>


        <!-- RADIUS -->

        <section class="theme-section">

            <div class="theme-section-title">
                گردی المان‌ها
            </div>

            <div class="theme-select">

                <button data-radius-select="sharp">
                    کم
                </button>

                <button data-radius-select="medium">
                    متوسط
                </button>

                <button data-radius-select="round">
                    زیاد
                </button>

            </div>

        </section>

    </div>


    <div class="theme-drawer-footer">

        <button id="resetTheme" class="reset-theme">

            ↻
            بازگردانی تنظیمات

        </button>

    </div>

</aside>

        <!-- تب‌های ناوبری -->
        <nav class="tabs">
            @foreach (var tab in tabs)
            {
                var active = string.Equals(controller, tab.Controller, StringComparison.OrdinalIgnoreCase);
                <a class="chip@(active ? " active" : "")" style="text-decoration:none"
                   asp-controller="@tab.Controller" asp-action="Index"><i></i> @tab.Label</a>
            }
        </nav>

        <main>
            @RenderBody()

           
        </main>
      
        <footer class="foot">
            <p>سامانه معادل‌سازی داینامیک داده‌ها - طراحی شده برای یکپارچه‌سازی اطلاعات واحدهای سازمانی</p>
        </footer>
    </div>

    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script>
        // میان‌بر Ctrl + K برای جستجوی سریع
        document.addEventListener("keydown", function (e) {
            if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") {
                e.preventDefault();
                var input = document.getElementById("globalSearch");
                if (input) { input.focus(); input.select(); }
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
