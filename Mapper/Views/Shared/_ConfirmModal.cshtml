@* مودال تأیید عمومی: دکمه‌ای با data-confirm-target (شناسه یک فرم) و data-confirm-message. *@
<div id="confirmOverlay" class="modal-overlay hidden" role="dialog" aria-modal="true" aria-labelledby="confirmTitle">
    <div class="modal-box">
        <h3 id="confirmTitle">تأیید عملیات</h3>
        <p id="confirmMessage"></p>
        <div class="modal-actions">
            <button type="button" class="btn ghost" id="confirmCancelBtn">انصراف</button>
            <button type="button" class="btn danger" id="confirmOkBtn">تأیید</button>
        </div>
    </div>
</div>
