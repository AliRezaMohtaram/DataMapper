@model Borc.DataMapper.Application.Templates.UpdateTemplate.UpdateTemplateCommand
@{
    ViewData["Title"] = "ویرایش قالب";

    var modelErrors = ViewData.ModelState
        .Where(kv => string.IsNullOrEmpty(kv.Key))
        .SelectMany(kv => kv.Value!.Errors)
        .Select(e => e.ErrorMessage)
        .Where(m => !string.IsNullOrWhiteSpace(m))
        .ToList();
}

<div class="panel card">
    <div class="panel-header">
        <h2>ویرایش قالب</h2>
    </div>

    @if (modelErrors.Count > 0)
    {
        <div class="status error show">@string.Join(" — ", modelErrors)</div>
    }

    <form asp-action="Edit" method="post">
        <input asp-for="Id" type="hidden" />

        <div class="form-group">
            <label>کد قالب:</label>
            <input type="text" dir="ltr" value="@ViewData["Code"]" disabled />
            <div class="hint">کد پس از ایجاد قابل تغییر نیست. وضعیت از صفحه جزئیات تغییر می‌کند.</div>
        </div>

        <div class="form-group">
            <label asp-for="Name">نام قالب:</label>
            <input asp-for="Name" autocomplete="off" />
            <span asp-validation-for="Name" style="color:var(--danger);font-size:12px"></span>
        </div>

        <div class="form-group">
            <label asp-for="Description">توضیحات (اختیاری):</label>
            <textarea asp-for="Description" rows="3"></textarea>
            <span asp-validation-for="Description" style="color:var(--danger);font-size:12px"></span>
        </div>

        <div class="actions">
            <button type="submit" class="btn primary">ذخیره تغییرات</button>
            <a asp-action="Detail" asp-route-id="@Model.Id" class="btn ghost">انصراف</a>
        </div>
    </form>
</div>
