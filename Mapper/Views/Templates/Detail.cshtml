@model Borc.DataMapper.Application.Templates.GetTemplate.TemplateDetailDto
@using Borc.DataMapper.Web.ViewModels.Dashboard
@{
    ViewData["Title"] = Model.Name;
    ViewData["Subtitle"] = $"قالب {Model.Code} · {Model.Versions.Count.ToPersianNumber()} نسخه";

    var published = Model.Versions.FirstOrDefault(v => v.Status == TemplateVersionStatus.Published);
    var draft = Model.Versions.FirstOrDefault(v => v.Status == TemplateVersionStatus.Draft);
    var here = Context.Request.Path.ToString();
}

@section TopbarActions {
    <a class="btn btn-ghost" asp-action="Index"><svg class="ico"><use href="#i-chev-right" /></svg><span class="lbl">همه قالب‌ها</span></a>
}

@if (published is null)
{
    <div class="callout tone-warning" style="margin-bottom:1rem">
        <svg class="ico"><use href="#i-alert" /></svg>
        <div>
            این قالب هنوز <b>نسخهٔ منتشرشده</b> ندارد؛ ایمپورت فایل و ثبت رکورد فقط روی نسخهٔ منتشرشده ممکن است.
            @if (draft is not null)
            {
                <text>فیلدهای <a class="link-btn" asp-controller="TemplateVersions" asp-action="Detail" asp-route-id="@draft.Id">نسخهٔ @draft.VersionNo.ToPersianNumber() (پیش‌نویس)</a> را کامل و منتشر کنید.</text>
            }
            else
            {
                <text>یک نسخهٔ جدید بسازید و فیلدهایش را تعریف کنید.</text>
            }
        </div>
    </div>
}

<div class="split">

    <article class="card rise">
        <header class="card-head">
            <div class="card-title">
                <span class="card-ico"><svg class="ico"><use href="#i-layout" /></svg></span>
                <div>نسخه‌ها<div class="card-sub">هر تغییر در فیلدها در یک نسخهٔ پیش‌نویس انجام و سپس منتشر می‌شود.</div></div>
            </div>
            <form asp-controller="TemplateVersions" asp-action="Create" method="post">
                <input type="hidden" name="templateId" value="@Model.Id" />
                <button type="submit" class="btn btn-soft btn-sm"><svg class="ico"><use href="#i-plus" /></svg>نسخهٔ جدید</button>
            </form>
        </header>

        @if (Model.Versions.Count == 0)
        {
            <div class="empty">هنوز نسخه‌ای برای این قالب ساخته نشده است.</div>
        }
        else
        {
            <div class="tbl-wrap">
                <table class="tbl">
                    <thead><tr><th>نسخه</th><th>وضعیت</th><th>فیلدها</th><th>چیدمان فرم</th><th>ایجاد</th><th>انتشار</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var v in Model.Versions)
                        {
                            <tr>
                                <td><a class="cell-main" asp-controller="TemplateVersions" asp-action="Detail" asp-route-id="@v.Id">نسخهٔ @v.VersionNo.ToPersianNumber()</a></td>
                                <td><span class="badge @v.Status.BadgeClass()">@v.Status.ToLabel()</span></td>
                                <td class="nums">@v.FieldCount.ToPersianNumber()</td>
                                <td>
                                    @if (v.HasLayout)
                                    {
                                        <span class="tag tone-success">طراحی‌شده</span>
                                    }
                                    else
                                    {
                                        <span class="tag" style="--tone:var(--line-rgb)">فرم خودکار</span>
                                    }
                                </td>
                                <td class="cell-sub nums">@v.CreatedAt.ToJalali().ToPersianDigits()</td>
                                <td class="cell-sub nums">@(v.PublishedAt.HasValue ? v.PublishedAt.ToJalali().ToPersianDigits() : "—")</td>
                                <td>
                                    <div class="row-actions">
                                        <a class="icon-btn sm primary" asp-controller="TemplateVersions" asp-action="Detail" asp-route-id="@v.Id" title="فیلدهای نسخه" aria-label="فیلدهای نسخهٔ @v.VersionNo"><svg class="ico"><use href="#i-eye" /></svg></a>
                                        <a class="icon-btn sm" asp-controller="TemplateLayouts" asp-action="Designer" asp-route-versionId="@v.Id" title="طراح چیدمان فرم" aria-label="طراح چیدمان نسخهٔ @v.VersionNo"><svg class="ico"><use href="#i-layout" /></svg></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </article>

    <aside class="split-side">
        <article class="card rise" style="--i:1">
            <div class="card-body">
                <div class="row" style="justify-content:space-between;align-items:flex-start">
                    <div class="hero-title">@Model.Name</div>
                    <span class="badge @Model.Status.BadgeClass()">@Model.Status.ToLabel()</span>
                </div>
                <div class="code" style="margin-top:.2rem">@Model.Code</div>
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p class="hero-desc">@Model.Description</p>
                }

                <dl class="dl stacked" style="margin-top:1rem">
                    <div><dt>نسخهٔ منتشرشده</dt><dd>@(published is null ? "—" : $"نسخهٔ {published.VersionNo.ToPersianNumber()} · {published.FieldCount.ToPersianNumber()} فیلد")</dd></div>
                    <div><dt>تاریخ ایجاد</dt><dd class="nums">@Model.CreatedAt.ToJalali().ToPersianDigits()</dd></div>
                    <div><dt>آخرین ویرایش</dt><dd class="nums">@Model.UpdatedAt.ToJalali().ToPersianDigits()</dd></div>
                </dl>
            </div>

            <div class="card-foot" style="display:block">
                <div class="action-stack">
                    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id" asp-route-returnUrl="@here" data-modal><svg class="ico"><use href="#i-edit" /></svg>ویرایش مشخصات</a>

                    @foreach (var target in Model.AllowedStatuses)
                    {
                        var formId = $"statusForm_{target}";
                        <form id="@formId" asp-action="ChangeStatus" method="post" hidden>
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="status" value="@target" />
                        </form>

                        @if (target == TemplateStatus.Archived)
                        {
                            <button type="button" class="btn btn-ghost" data-confirm-target="@formId"
                                    data-confirm-title="بایگانی قالب"
                                    data-confirm-message="بایگانی قالب غیرقابل بازگشت است. ادامه می‌دهید؟">
                                <svg class="ico"><use href="#i-download" /></svg>@target.ToActionLabel()
                            </button>
                        }
                        else
                        {
                            <button type="submit" form="@formId" class="btn btn-ghost"><svg class="ico"><use href="#i-refresh" /></svg>@target.ToActionLabel()</button>
                        }
                    }

                    <div class="dd-sep"></div>
                    <button type="button" class="btn btn-danger-soft" data-delete-id="@Model.Id" data-delete-name="@Model.Name">
                        <svg class="ico"><use href="#i-trash" /></svg>حذف قالب
                    </button>
                </div>
            </div>
        </article>
    </aside>
</div>

<partial name="_DeleteModal" />
<partial name="_ConfirmModal" />

@section Scripts {
    <script src="~/js/confirm-delete.js" asp-append-version="true"></script>
    <script src="~/js/confirm-action.js" asp-append-version="true"></script>
}
