@model IReadOnlyList<Borc.DataMapper.Web.Models.ViewModels.Templates.TemplateListItemViewModel>

@{
    ViewData["Title"] = "Templates";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">Templates</h2>
            <p class="text-muted mb-0">
                Manage data collection templates
            </p>
        </div>

        <a asp-controller="Templates"
           asp-action="Create"
           class="btn btn-primary">
            <span class="me-1">+</span>
            New Template
        </a>

    </div>

    <!-- Toolbar -->
    <div class="card shadow-sm mb-3">

        <div class="card-body">

            <div class="row g-3 align-items-end">

                <div class="col-md-5">

                    <label class="form-label">
                        Search
                    </label>

                    <input type="text"
                           id="templateSearch"
                           class="form-control"
                           placeholder="Search by code or name..." />

                </div>

                <div class="col-md-3">

                    <label class="form-label">
                        Status
                    </label>

                    <select id="templateStatus"
                            class="form-select">

                        <option value="">All</option>
                        <option value="active">Active</option>
                        <option value="inactive">Inactive</option>

                    </select>

                </div>

                <div class="col-md-auto">

                    <button type="button"
                            id="clearFilters"
                            class="btn btn-outline-secondary">
                        Clear
                    </button>

                </div>

            </div>

        </div>

    </div>

    <!-- Table -->
    <div class="card shadow-sm">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0"
                       id="templatesTable">

                    <thead class="table-light">

                        <tr>

                            <th style="width: 100px;">
                                ID
                            </th>

                            <th style="width: 180px;">
                                Code
                            </th>

                            <th>
                                Name
                            </th>

                            <th>
                                Description
                            </th>

                            <th style="width: 120px;">
                                Status
                            </th>

                            <th style="width: 160px;">
                                Created
                            </th>

                            <th style="width: 170px;">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model is not null && Model.Count > 0)
                        {
                            foreach (var template in Model)
                            {
                                <tr data-status="@(template.IsActive ? "active" : "inactive")">

                                    <td>
                                        <span class="text-muted">
                                            #@template.Id
                                        </span>
                                    </td>

                                    <td>
                                        <code>
                                            @template.Code
                                        </code>
                                    </td>

                                    <td>
                                        <strong>
                                            @template.Name
                                        </strong>
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(template.Description))
                                        {
                                            <span>
                                                @template.Description
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }
                                    </td>

                                    <td>

                                        @if (template.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inactive
                                            </span>
                                        }

                                    </td>

                                    <td>
                                        @template.CreatedAt.ToLocalTime()
                                        .ToString("yyyy/MM/dd HH:mm")
                                    </td>

                                    <td>

                                        <div class="btn-group btn-group-sm">

                                            <a asp-controller="Templates"
                                               asp-action="Details"
                                               asp-route-id="@template.Id"
                                               class="btn btn-outline-secondary">
                                                View
                                            </a>

                                            <a asp-controller="Templates"
                                               asp-action="Edit"
                                               asp-route-id="@template.Id"
                                               class="btn btn-outline-primary">
                                                Edit
                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr id="emptyRow">

                                <td colspan="7"
                                    class="text-center py-5">

                                    <div class="text-muted">

                                        <div class="fs-4 mb-2">
                                            No Templates
                                        </div>

                                        <div class="mb-3">
                                            No template has been created yet.
                                        </div>

                                        <a asp-controller="Templates"
                                           asp-action="Create"
                                           class="btn btn-primary">
                                            Create Template
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <script>

        (() => {

            const searchInput =
                document.getElementById('templateSearch');

            const statusSelect =
                document.getElementById('templateStatus');

            const clearButton =
                document.getElementById('clearFilters');

            const rows =
                document.querySelectorAll(
                    '#templatesTable tbody tr[data-status]'
                );

            function filterRows() {

                const search =
                    searchInput.value
                        .trim()
                        .toLowerCase();

                const status =
                    statusSelect.value;

                rows.forEach(row => {

                    const text =
                        row.textContent.toLowerCase();

                    const rowStatus =
                        row.dataset.status;

                    const matchSearch =
                        !search ||
                        text.includes(search);

                    const matchStatus =
                        !status ||
                        rowStatus === status;

                    row.style.display =
                        matchSearch && matchStatus
                            ? ''
                            : 'none';

                });

            }

            searchInput?.addEventListener(
                'input',
                filterRows
            );

            statusSelect?.addEventListener(
                'change',
                filterRows
            );

            clearButton?.addEventListener(
                'click',
                () => {

                    searchInput.value = '';
                    statusSelect.value = '';

                    filterRows();

                }
            );

        })();

    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>

}