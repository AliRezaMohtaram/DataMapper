<div class="panel card">
    <div class="panel-header">
        <h2>قالب‌های پایه</h2>

        <div class="summary-stats">
            <span>کل قالب‌ها: <b>@result.TotalCount</b></span>
            @if (result.TotalCount > 0)
            {
                <span>نمایش: <b>@from</b> تا <b>@to</b></span>
            }
        </div>

        <a asp-action="Create" class="btn primary">+ قالب جدید</a>
    </div>

    @if (errors.Count > 0)
    {
        <div class="status error show">@string.Join(" — ", errors)</div>
    }

    <div class="tscroll results-table-container">
        <table class="results-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>کد قالب</th>
                    <th>نام قالب</th>
                    <th>توضیحات</th>
                    <th>وضعیت</th>
                    <th>تاریخ ایجاد</th>
                    <th>عملیات</th>
                </tr>
            </thead>
            <tbody>
                @if (result.Items.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="entries-empty">
                            @(string.IsNullOrWhiteSpace(filter.Search)
                                                    ? "هنوز قالبی ثبت نشده است."
                                                    : "قالبی با این مشخصات پیدا نشد.")
                    </td>
                </tr>
                                }
                else
                {
                    foreach (var t in result.Items)
                    {
                        <tr>
                            <td>@t.Id</td>
                            <td><code dir="ltr" style="font-family:var(--mono)">@t.Code</code></td>
                            <td>@t.Name</td>
                            <td style="white-space:normal;min-width:220px;text-align:right">@t.Description</td>
                            <td><span class="mode-badge">@t.Status.ToLabel()</span></td>
                            <td dir="ltr">@t.CreatedAt.ToJalali()</td>
                            <td>
                                <div class="row-actions">
                                    <a asp-action="Detail" asp-route-id="@t.Id" class="btn ghost low-padding"
                                       title="جزئیات" aria-label="جزئیات">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                             fill="none" stroke="currentColor" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z" />
                                            <circle cx="12" cy="12" r="3" />
                                        </svg>
                                    </a>

                                    <a asp-action="Edit" asp-route-id="@t.Id" class="btn primary low-padding"
                                       title="ویرایش" aria-label="ویرایش">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                             fill="none" stroke="currentColor" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M12 20h9" />
                                            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z" />
                                        </svg>
                                    </a>

                                    <button type="button" class="btn danger low-padding"
                                            title="حذف" aria-label="حذف"
                                            data-delete-id="@t.Id" data-delete-name="@t.Name">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                             fill="none" stroke="currentColor" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="3 6 5 6 21 6" />
                                            <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                                            <path d="M10 11v6" />
                                            <path d="M14 11v6" />
                                            <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" />
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- صفحه‌بندی -->
    <div class="pagination">
        @if (result.HasPrevious)
        {
            <a class="btn ghost" asp-action="Index"
               asp-route-search="@filter.Search" asp-route-status="@filter.Status"
               asp-route-pageSize="@result.PageSize" asp-route-page="@(result.Page - 1)">قبلی</a>
        }
        else
        {
            <button type="button" class="btn ghost" disabled>قبلی</button>
        }

        <span>صفحه @result.Page از @Math.Max(1, result.TotalPages)</span>

        @if (result.HasNext)
        {
            <a class="btn ghost" asp-action="Index"
               asp-route-search="@filter.Search" asp-route-status="@filter.Status"
               asp-route-pageSize="@result.PageSize" asp-route-page="@(result.Page + 1)">بعدی</a>
        }
        else
        {
            <button type="button" class="btn ghost" disabled>بعدی</button>
        }

        <form method="get" asp-action="Index" style="display:inline">
            <input type="hidden" name="search" value="@filter.Search" />
            @if (filter.Status.HasValue)
            {
                <input type="hidden" name="status" value="@filter.Status" />
            }
            <label class="rpp-label">
                ردیف در صفحه:
                <select name="pageSize" onchange="this.form.submit()">
                    @foreach (var size in pageSizes)
                    {
                        <option value="@size" selected="@(result.PageSize == size)">@size</option>
                    }
                </select>
            </label>
        </form>
    </div>
</div>



<partial name="_DeleteModal" />
@section Scripts {
    <script src="~/js/confirm-delete.js" asp-append-version="true"></script>
}
