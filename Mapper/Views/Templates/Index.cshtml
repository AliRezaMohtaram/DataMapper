@model Borc.DataMapper.Web.ViewModels.Templates.TemplateIndexViewModel
@using Borc.DataMapper.Web.ViewModels.Dashboard
@{
    ViewData["Title"] = "قالب‌ها";

    var result = Model.Result;
    var filter = Model.Filter;
    var filtering = !string.IsNullOrWhiteSpace(filter.Search) || filter.Status.HasValue;
    var here = Context.Request.Path + Context.Request.QueryString;

    var errors = ViewData.ModelState.Values
        .SelectMany(v => v.Errors)
        .Select(e => e.ErrorMessage)
        .Where(m => !string.IsNullOrWhiteSpace(m))
        .ToList();

    var from = result.TotalCount == 0 ? 0 : (result.Page - 1) * result.PageSize + 1;
    var to = Math.Min(result.Page * result.PageSize, result.TotalCount);
    var pageSizes = new[] { 10, 20, 50, 100 };

    ViewData["Subtitle"] = $"{result.TotalCount.ToPersianNumber()} قالب · ساختار داده‌هایی که ایمپورت یا ثبت می‌شوند";
}

@section TopbarActions {
    <a acl-res="Mapper.Templates" acl-act="Create" class="btn btn-soft" asp-action="Create" data-modal><svg class="ico"><use href="#i-plus" /></svg><span class="lbl">قالب جدید</span></a>
}

@if (errors.Count > 0)
{
    <div class="callout tone-danger" role="alert" style="margin-bottom:1rem">
        <svg class="ico"><use href="#i-alert" /></svg><div>@string.Join(" — ", errors)</div>
    </div>
}

<article class="card rise">
    <header class="card-head">
        <div class="card-title">
            <span class="card-ico"><svg class="ico"><use href="#i-template" /></svg></span>
            <div>قالب‌های پایه<div class="card-sub">هر قالب نسخه‌هایی دارد؛ ایمپورت و ثبت رکورد روی نسخهٔ منتشرشده انجام می‌شود.</div></div>
        </div>
    </header>

    <div class="toolbar">
        <form acl-res="Mapper.Templates" acl-act="View" method="get" asp-action="Index" role="search">
            <input type="hidden" name="pageSize" value="@result.PageSize" />
            <div class="input-wrap">
                <svg class="ico"><use href="#i-search" /></svg>
                <input class="input" type="search" name="search" value="@filter.Search" placeholder="جستجو بر اساس کد یا نام…" aria-label="جستجو در قالب‌ها" autocomplete="off" />
            </div>
            <select class="select" name="status" aria-label="وضعیت" onchange="this.form.requestSubmit()">
                <option value="">همهٔ وضعیت‌ها</option>
                @foreach (var st in Enum.GetValues<TemplateStatus>())
                {
                    <option value="@st" selected="@(filter.Status == st)">@st.ToLabel()</option>
                }
            </select>
            <button type="submit" class="btn btn-ghost"><svg class="ico"><use href="#i-search" /></svg>جستجو</button>
            @if (filtering)
            {
                <a acl-res="Mapper.Templates" acl-act="View" class="btn btn-quiet" asp-action="Index" asp-route-pageSize="@result.PageSize"><svg class="ico"><use href="#i-x" /></svg>پاک کردن فیلتر</a>
            }
        </form>
    </div>

    @if (result.Items.Count == 0)
    {
        <div class="empty">
            @if (filtering)
            {
                <p>قالبی با این مشخصات پیدا نشد.</p>
                <a acl-res="Mapper.Templates" acl-act="View" class="btn btn-ghost btn-sm" style="margin-top:.8rem" asp-action="Index">پاک کردن فیلتر</a>
            }
            else
            {
                <p>هنوز قالبی ساخته نشده است.</p>
                <a acl-res="Mapper.Templates" acl-act="Create" class="btn btn-primary btn-sm" style="margin-top:.8rem" asp-action="Create" data-modal><svg class="ico"><use href="#i-plus" /></svg>ساخت اولین قالب</a>
            }
        </div>
    }
    else
    {
        <div class="tbl-wrap">
            <table class="tbl">
                <thead>
                    <tr><th>قالب</th><th>توضیحات</th><th>وضعیت</th><th>ایجاد</th><th>آخرین تغییر</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var t in result.Items)
                    {
                        <tr>
                            <td>
                                <a acl-res="Mapper.Templates" acl-act="View" class="cell-main" asp-action="Detail" asp-route-id="@t.Id">@t.Name</a>
                                <div class="code">@t.Code</div>
                            </td>
                            <td class="cell-sub" style="max-width:24rem;white-space:normal">@(string.IsNullOrWhiteSpace(t.Description) ? "—" : t.Description)</td>
                            <td><span class="badge @t.Status.BadgeClass()">@t.Status.ToLabel()</span></td>
                            <td class="cell-sub nums">@t.CreatedAt.ToJalali().ToPersianDigits()</td>
                            <td class="cell-sub">@((t.UpdatedAt ?? t.CreatedAt).ToRelative())</td>
                            <td>
                                <div class="row-actions">
                                    <a acl-res="Mapper.Templates" acl-act="View" class="icon-btn sm primary" asp-action="Detail" asp-route-id="@t.Id" title="جزئیات و نسخه‌ها" aria-label="جزئیات @t.Name"><svg class="ico"><use href="#i-eye" /></svg></a>
                                    <a acl-res="Mapper.Templates" acl-act="Edit" class="icon-btn sm" asp-action="Edit" asp-route-id="@t.Id" asp-route-returnUrl="@here" data-modal title="ویرایش" aria-label="ویرایش @t.Name"><svg class="ico"><use href="#i-edit" /></svg></a>
                                    <button class="icon-btn sm danger" type="button" data-delete-id="@t.Id" data-delete-name="@t.Name" title="حذف" aria-label="حذف @t.Name"><svg class="ico"><use href="#i-trash" /></svg></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (result.TotalCount > 0)
    {
        <footer class="card-foot">
            <span>@from.ToPersianNumber() تا @to.ToPersianNumber() از @result.TotalCount.ToPersianNumber()</span>

            <nav class="pager" aria-label="صفحه‌بندی">
                @if (result.HasPrevious)
                {
                    <a acl-res="Mapper.Templates" acl-act="View" asp-action="Index" asp-route-search="@filter.Search" asp-route-status="@filter.Status" asp-route-pageSize="@result.PageSize" asp-route-page="@(result.Page - 1)" rel="prev" aria-label="صفحه قبل"><svg class="ico"><use href="#i-chev-right" /></svg></a>
                }
                else
                {
                    <span aria-disabled="true"><svg class="ico"><use href="#i-chev-right" /></svg></span>
                }
                <span class="pager-now" aria-current="page">صفحه @result.Page.ToPersianNumber() از @Math.Max(1, result.TotalPages).ToPersianNumber()</span>
                @if (result.HasNext)
                {
                    <a acl-res="Mapper.Templates" acl-act="View" asp-action="Index" asp-route-search="@filter.Search" asp-route-status="@filter.Status" asp-route-pageSize="@result.PageSize" asp-route-page="@(result.Page + 1)" rel="next" aria-label="صفحه بعد"><svg class="ico"><use href="#i-chev-left" /></svg></a>
                }
                else
                {
                    <span aria-disabled="true"><svg class="ico"><use href="#i-chev-left" /></svg></span>
                }
            </nav>

            <form acl-res="Mapper.Templates" acl-act="View" method="get" asp-action="Index" class="page-size">
                <input type="hidden" name="search" value="@filter.Search" />
                <input type="hidden" name="status" value="@filter.Status" />
                <label for="pageSize">ردیف در صفحه</label>
                <select class="select" id="pageSize" name="pageSize" onchange="this.form.submit()">
                    @foreach (var size in pageSizes)
                    {
                        <option value="@size" selected="@(result.PageSize == size)">@size.ToPersianNumber()</option>
                    }
                </select>
            </form>
        </footer>
    }
</article>

<partial name="_DeleteModal" />

@section Scripts {
    <script src="~/js/confirm-delete.js" asp-append-version="true"></script>
}
