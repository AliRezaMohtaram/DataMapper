@model Borc.DataMapper.Application.TemplateVersions.GetTemplateVersion.TemplateVersionDetailDto
@{
    ViewData["Title"] = $"{Model.TemplateName} - نسخه {Model.VersionNo}";

    var isDraft = Model.Status == TemplateVersionStatus.Draft;
    var isArchived = Model.Status == TemplateVersionStatus.Archived;
}

<div class="panel card">
    <div class="panel-header">
        <h2>
            @Model.TemplateName — نسخه @Model.VersionNo
            <span class="mode-badge">@Model.Status.ToLabel()</span>
        </h2>

        <div class="row-actions">
            <a acl-res="Mapper.Templates" acl-act="View" asp-controller="Templates" asp-action="Detail" asp-route-id="@Model.TemplateId" class="btn ghost">بازگشت به قالب</a>
            <a acl-res="Mapper.Templates" acl-act="Edit" asp-controller="TemplateLayouts" asp-action="Designer" asp-route-versionId="@Model.Id"
               class="btn secondary">"مشاهده Layout</a>
            <a acl-res="Mapper.Templates" acl-act="Edit" asp-controller="TemplateLayouts" asp-action="Designer" asp-route-versionId="@Model.Id"
               class="btn secondary">"طراحی Layout"</a>

            @if (isDraft)
            {
                <form acl-res="Mapper.Templates" acl-act="Edit" id="publishForm" asp-action="Publish" method="post" style="display:none">
                    <input type="hidden" name="id" value="@Model.Id" />
                </form>
                <button type="button" class="btn primary"
                        data-confirm-target="publishForm"
                        data-confirm-message="با انتشار، نسخه تغییرناپذیر می‌شود و نسخه منتشرشده قبلی این قالب بایگانی می‌شود. ادامه می‌دهید؟">
                    انتشار
                </button>
            }

            @if (!isArchived)
            {
                <form acl-res="Mapper.Templates" acl-act="Edit" id="archiveForm" asp-action="Archive" method="post" style="display:none">
                    <input type="hidden" name="id" value="@Model.Id" />
                </form>
                <button type="button" class="btn secondary"
                        data-confirm-target="archiveForm"
                        data-confirm-message="بایگانی نسخه غیرقابل بازگشت است. ادامه می‌دهید؟">
                    بایگانی
                </button>
            }

            @if (isDraft)
            {
                <button type="button" class="btn danger"
                        data-delete-id="@Model.Id" data-delete-name="نسخه @Model.VersionNo">
                    حذف
                </button>
            }
        </div>
    </div>

    <div class="form-group">
        <label>کد قالب:</label>
        <div dir="ltr" style="text-align:right"><code style="font-family:var(--mono)">@Model.TemplateCode</code></div>
    </div>

    <div class="summary-stats">
        <span>تاریخ ایجاد: <b dir="ltr">@Model.CreatedAt.ToJalali()</b></span>
        <span>آخرین ویرایش: <b dir="ltr">@Model.UpdatedAt.ToJalali()</b></span>
        <span>تاریخ انتشار: <b dir="ltr">@Model.PublishedAt.ToJalali()</b></span>
    </div>
</div>

<div class="panel card">
    <div class="panel-header">
        <h2>فیلدها</h2>
        <div class="summary-stats"><span>تعداد: <b>@Model.Fields.Count</b></span></div>

        @if (isDraft)
        {
            <a acl-res="Mapper.Templates" acl-act="Edit" asp-controller="TemplateFields" asp-action="Create"
               asp-route-templateVersionId="@Model.Id" class="btn primary">+ فیلد جدید</a>
        }
    </div>

    <div class="tscroll results-table-container">
        <table class="results-table">
            <thead>
                <tr>
                    <th>ترتیب</th>
                    <th>کلید فیلد</th>
                    <th>برچسب</th>
                    <th>نوع داده</th>
                    <th>نوع در مقصد</th>
                    <th>الزامی</th>
                    <th>تعداد alias</th>
                    <th>عملیات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Fields.Count == 0)
                {
                    <tr><td colspan="8" class="entries-empty">این نسخه هنوز فیلدی ندارد.</td></tr>
                }
                else
                {
                    foreach (var f in Model.Fields)
                    {
                        <tr>
                            <td>@f.SortOrder</td>
                            <td dir="ltr"><code style="font-family:var(--mono)">@f.FieldKey</code></td>
                            <td>@f.Label</td>
                            <td>@f.DataType.ToLabel()</td>
                            <td dir="ltr">@f.DbType</td>
                            <td>@(f.IsRequired ? "بله" : "—")</td>
                            <td>@f.AliasCount</td>
                            <td>
                                @if (isDraft)
                                {
                                    <div class="row-actions">
                                        <a acl-res="Mapper.Templates" acl-act="Edit" asp-controller="TemplateFields" asp-action="Edit" asp-route-id="@f.Id"
                                           class="btn primary low-padding" title="ویرایش" aria-label="ویرایش">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                                 fill="none" stroke="currentColor" stroke-width="2"
                                                 stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M12 20h9" />
                                                <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z" />
                                            </svg>
                                        </a>

                                        <button type="button" class="btn danger low-padding" title="حذف" aria-label="حذف"
                                                data-delete-id="@f.Id" data-delete-name="@f.FieldKey"
                                                data-delete-url="@Url.Action("Delete", "TemplateFields")">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                                 fill="none" stroke="currentColor" stroke-width="2"
                                                 stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="3 6 5 6 21 6" />
                                                <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                                                <path d="M10 11v6" />
                                                <path d="M14 11v6" />
                                                <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" />
                                            </svg>
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <text>—</text>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_DeleteModal" />
<partial name="_ConfirmModal" />

@section Scripts {
    <script src="~/js/confirm-delete.js" asp-append-version="true"></script>
    <script src="~/js/confirm-action.js" asp-append-version="true"></script>
}
