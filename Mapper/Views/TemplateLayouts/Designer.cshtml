@model Borc.DataMapper.Web.ViewModels.TemplateLayouts.LayoutDesignerViewModel
@{
    ViewData["Title"] = $"طراح چیدمان فرم — {Model.TemplateName}";
    ViewData["Crumbs"] = new[]
    {
        new Borc.DataMapper.Web.ViewModels.Crumb(Model.TemplateName, Url.Action("Detail", "Templates", new { id = Model.TemplateId })),
        new Borc.DataMapper.Web.ViewModels.Crumb($"نسخهٔ {Model.VersionNo.ToPersianNumber()}", Url.Action("Detail", "TemplateVersions", new { id = Model.TemplateVersionId })),
    };
    var isDraft = Model.VersionStatus == TemplateVersionStatus.Draft;
}

<link rel="stylesheet" href="~/css/layout-designer.css" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="ld-shell">
    <div class="ld-topbar">
        <div class="ld-title">
            <b>چیدمان فرم ورود داده</b>
            <span class="faint">@Model.TemplateName · نسخهٔ @Model.VersionNo.ToPersianNumber()</span>
            <span class="badge @(isDraft ? "st-draft" : "st-validated")">@Model.VersionStatus.ToLabel()</span>
        </div>
        <span id="ldStatus"></span>
        <div class="ld-topbar-actions" id="ldActions"></div>
        <a acl-res="Mapper.Templates" acl-act="View" class="btn btn-ghost btn-sm" asp-controller="TemplateVersions" asp-action="Detail" asp-route-id="@Model.TemplateVersionId">
            <svg class="ico"><use href="#i-chev-right" /></svg>بازگشت به نسخه
        </a>
    </div>

    @if (isDraft)
    {
        <p class="hint ld-intro">فیلدها را از فهرست کنار روی فرم بکشید و بچینید؛ چیدمان ذخیره‌شده به‌جای فرم خودکار برای ورود داده استفاده می‌شود.</p>
    }
    else
    {
        <div class="callout tone-info ld-intro">
            <svg class="ico"><use href="#i-info" /></svg>
            <div>این نسخه پیش‌نویس نیست و چیدمانش فقط برای مشاهده است. برای تغییر، یک نسخهٔ تازه بسازید.</div>
        </div>
    }

    <div id="ldBoard" class="ld-board">
        <aside class="ld-pane ld-palette" id="ldPalette"></aside>
        <main class="ld-stage" id="ldStage"></main>
        <aside class="ld-pane ld-props" id="ldProps"></aside>
    </div>
</div>

<script id="ldData" type="application/json">@Html.Raw(Model.DataJson)</script>

<partial name="_ConfirmModal" />

@section Scripts {
    <script src="~/js/ui.js" asp-append-version="true"></script>
    <script src="~/js/layout-designer.js" asp-append-version="true"></script>
}
