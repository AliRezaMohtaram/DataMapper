@model Borc.DataMapper.Application.TemplateFields.UpdateTemplateField.UpdateTemplateFieldCommand
@using Borc.DataMapper.Application.TemplateFields.GetTemplateField
@{
    var info = (TemplateFieldDetailDto)ViewData["Info"]!;
    ViewData["Title"] = $"ویرایش فیلد {info.FieldKey}";
}
@* معمولاً این فرم از صفحهٔ نسخه در مودال باز می‌شود (data-modal)؛ این صفحه برای لینک مستقیم و حالت بدون JavaScript است. *@
<div class="modal-page">
    <partial name="_FieldForm" model="Model" />
</div>

<partial name="_DeleteModal" />

@section Scripts {
    <script src="~/js/confirm-delete.js" asp-append-version="true"></script>
}
