@model Borc.DataMapper.Application.DataRecords.GetDataRecord.DataRecordDetailDto
@using Borc.DataMapper.Domain.Common
@using Borc.DataMapper.Web.ViewModels.DataRecords
@using Borc.DataMapper.Domain.Records
@{
    ViewData["Title"] = $"رکورد {Model.Id}";

    var canEdit = Model.VersionStatus == TemplateVersionStatus.Published;
}

<div class="page-grid">

    <!-- ===== محتوای اصلی ===== -->
    <section class="page-main">
        <div class="panel card">
            <div class="panel-header">
                <h2>مقدارهای رکورد</h2>
                <div class="summary-stats"><span>فیلدها: <b>@Model.Values.Count</b></span></div>
            </div>

            <div class="tscroll results-table-container">
                <table class="results-table">
                    <thead>
                        <tr>
                            <th>فیلد</th>
                            <th>نوع</th>
                            <th>مقدار</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var v in Model.Values)
                    {
                        <tr>
                            <td>
                                @v.Label
                                @if (v.IsExtra)
                                {
                                    <span class="mode-badge" title="این کلید دیگر در قالب وجود ندارد">خارج از قالب</span>
                                }
                                else
                                {
                                    <div dir="ltr" style="text-align:right"><code style="font-family:var(--mono);font-size:11px">@v.Key</code></div>
                                }
                            </td>
                            <td>@(v.IsExtra ? "—" : v.DataType.ToLabel())</td>
                            <td>
                                @if (string.IsNullOrEmpty(v.Value))
                                {
                                        <span style="color:var(--muted)">—</span>
                                    }
                                    else if (v.DataType == Borc.DataMapper.Domain.Common.FieldDataType.Number || v.DataType == FieldDataType.Date || v.DataType == FieldDataType.DateTime)
                                    {
                                    <span dir="ltr">@v.Value</span>
                                }
                                else
                                {
                                    @v.Value
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <!-- ===== اطلاعات کلی (aside سمت چپ) ===== -->
    <aside class="page-aside">
        <div class="panel card">
            <div class="aside-title">رکورد @Model.Id</div>
            <span class="mode-badge">@Model.Source.ToLabel()</span>

            <dl class="info-list">
                <div>
                    <dt>قالب</dt>
                    <dd><a asp-controller="Templates" asp-action="Detail" asp-route-id="@Model.TemplateId">@Model.TemplateName</a></dd>
                </div>
                <div>
                    <dt>نسخه</dt>
                    <dd>
                        <a asp-controller="TemplateVersions" asp-action="Detail" asp-route-id="@Model.TemplateVersionId">نسخه @Model.VersionNo</a>
                        <span class="mode-badge">@Model.VersionStatus.ToLabel()</span>
                    </dd>
                </div>
                @if (Model.ImportBatchId.HasValue)
                {
                    <div>
                        <dt>ایمپورت مبدأ</dt>
                        <dd>
                            <a asp-controller="Imports" asp-action="Detail" asp-route-id="@Model.ImportBatchId">@(Model.ImportFileName ?? $"#{Model.ImportBatchId}")</a>
                            @if (Model.ImportRowNumber.HasValue)
                            {
                                <div>سطر @Model.ImportRowNumber</div>
                            }
                        </dd>
                    </div>
                }
                <div>
                    <dt>تاریخ ثبت</dt>
                    <dd dir="ltr" style="text-align:right">@Model.CreatedAt.ToJalali()</dd>
                </div>
                <div>
                    <dt>آخرین ویرایش</dt>
                    <dd dir="ltr" style="text-align:right">@Model.UpdatedAt.ToJalali()</dd>
                </div>
            </dl>

            <div class="aside-actions">
                @if (canEdit)
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn primary block">ویرایش رکورد</a>
                }
                else
                {
                    <div class="hint">نسخهٔ این رکورد منتشرشده نیست؛ ویرایش داده ممکن نیست.</div>
                }

                <button type="button" class="btn danger block"
                        data-delete-id="@Model.Id" data-delete-name="رکورد @Model.Id">حذف رکورد</button>

                <a asp-action="Index" asp-route-templateVersionId="@Model.TemplateVersionId" class="btn ghost block">رکوردهای این نسخه</a>
            </div>
        </div>
    </aside>
</div>

<partial name="_DeleteModal" />

@section Scripts {
    <script src="~/js/confirm-delete.js" asp-append-version="true"></script>
}
