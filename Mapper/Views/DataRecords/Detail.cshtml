@model Borc.DataMapper.Application.DataRecords.GetDataRecord.DataRecordDetailDto
@using Borc.DataMapper.Domain.Common
@using Borc.DataMapper.Web.ViewModels.DataRecords
@using Borc.DataMapper.Web.ViewModels.Dashboard
@using Borc.DataMapper.Domain.Records
@* مقدارها به‌صورت جدول افقی (سرستون = فیلد قالب، مثل فهرست رکوردها)؛ مشخصات رکورد در کارت بالای صفحه. *@
@{
    ViewData["Title"] = $"رکورد {Model.Id}";
    ViewData["Subtitle"] = $"{Model.TemplateName} · نسخهٔ {Model.VersionNo.ToPersianNumber()}";
    ViewData["Crumbs"] = new[] { new Crumb($"{Model.TemplateName} · نسخهٔ {Model.VersionNo.ToPersianNumber()}", Url.Action("Index", "DataRecords", new { templateVersionId = Model.TemplateVersionId })) };

    var canEdit = Model.VersionStatus == TemplateVersionStatus.Published;
    var filled = Model.Values.Count(v => !string.IsNullOrEmpty(v.Value));
    var extra = Model.Values.Count(v => v.IsExtra);
}

@section TopbarActions {
    @* قبلی/بعدی به ترتیب فهرست رکوردهای همین نسخه (جدیدترین اول) *@
    <div class="row" style="gap:.35rem;align-items:center">
        @if (Model.Neighbors.PreviousId is { } prev)
        {
            <a acl-res="Mapper.DataRecords" acl-act="View" class="icon-btn" asp-action="Detail" asp-route-id="@prev" title="رکورد قبلی" aria-label="رکورد قبلی"><svg class="ico"><use href="#i-chev-right" /></svg></a>
        }
        else
        {
            <span class="icon-btn" aria-disabled="true" style="opacity:.4"><svg class="ico"><use href="#i-chev-right" /></svg></span>
        }
        <span class="cell-sub nums hide-mobile">@Model.Neighbors.Position.ToPersianNumber() از @Model.Neighbors.Total.ToPersianNumber()</span>
        @if (Model.Neighbors.NextId is { } next)
        {
            <a acl-res="Mapper.DataRecords" acl-act="View" class="icon-btn" asp-action="Detail" asp-route-id="@next" title="رکورد بعدی" aria-label="رکورد بعدی"><svg class="ico"><use href="#i-chev-left" /></svg></a>
        }
        else
        {
            <span class="icon-btn" aria-disabled="true" style="opacity:.4"><svg class="ico"><use href="#i-chev-left" /></svg></span>
        }
    </div>
}

<article class="card rise">
    <header class="card-head">
        <div class="card-title">
            <span class="card-ico"><svg class="ico"><use href="#i-rows" /></svg></span>
            <div>
                رکورد <span class="code" style="font-size:.95rem">@Model.Id</span>
                <span class="badge @(Model.Source == RecordSource.Import ? "st-uploaded" : "st-validated")">@Model.Source.ToLabel()</span>
                <div class="card-sub">
                    <a acl-res="Mapper.Templates" acl-act="View" class="link-btn" asp-controller="Templates" asp-action="Detail" asp-route-id="@Model.TemplateId">@Model.TemplateName</a>
                    · @filled.ToPersianNumber() از @Model.Values.Count.ToPersianNumber() فیلد مقدار دارد@(extra > 0 ? $" · {extra.ToPersianNumber()} کلید خارج از قالب" : "")
                </div>
            </div>
        </div>
        <div class="row" style="gap:.5rem">
            @if (canEdit)
            {
                <a acl-res="Mapper.DataRecords" acl-act="Edit" class="btn btn-primary btn-sm" asp-action="Edit" asp-route-id="@Model.Id" data-modal><svg class="ico"><use href="#i-edit" /></svg>ویرایش رکورد</a>
                <a acl-res="Mapper.DataRecords" acl-act="Create" class="btn btn-ghost btn-sm" asp-action="Create" asp-route-copyFrom="@Model.Id" data-modal title="رکورد جدید با همین مقدارها"><svg class="ico"><use href="#i-copy" /></svg>رونوشت</a>
            }
            <button acl-res="Mapper.DataRecords" acl-act="Delete" type="button" class="btn btn-danger-soft btn-sm" data-delete-id="@Model.Id" data-delete-name="رکورد @Model.Id"><svg class="ico"><use href="#i-trash" /></svg>حذف</button>
        </div>
    </header>

    <div class="tbl-wrap">
        <table class="tbl">
            <thead>
                <tr>
                    @foreach (var v in Model.Values)
                    {
                        <th>
                            @v.Label
                            @if (v.IsExtra)
                            {
                                <span class="badge st-archived" title="این کلید دیگر در قالب وجود ندارد">خارج از قالب</span>
                            }
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                <tr>
                    @foreach (var v in Model.Values)
                    {
                        var ltr = v.DataType is FieldDataType.Number or FieldDataType.Date or FieldDataType.DateTime;
                        <td style="white-space:normal;min-width:8rem;max-width:22rem">
                            @if (string.IsNullOrEmpty(v.Value))
                            {
                                <span class="faint">—</span>
                            }
                            else if (ltr && !v.IsExtra)
                            {
                                <span class="ltr nums">@v.Value.ToRecordDisplay(v.DataType)</span>
                            }
                            else
                            {
                                @v.Value
                            }
                        </td>
                    }
                </tr>
            </tbody>
        </table>
    </div>

    @if (!canEdit)
    {
        <div class="card-body"><p class="hint" style="margin:0">نسخهٔ این رکورد منتشرشده نیست؛ ویرایش داده ممکن نیست.</p></div>
    }

    <footer class="card-foot">
        <dl class="dl" style="grid-template-columns:repeat(auto-fit, minmax(10rem, 1fr));width:100%">
            <div><dt>واحد سازمانی</dt><dd><partial name="_OrgUnitBadge" model="(Borc.DataMapper.Application.OrgUnits.OrgUnitOwnedKind.DataRecord, Model.Id)" /></dd></div>
            <div>
                <dt>نسخهٔ قالب</dt>
                <dd>
                    <a acl-res="Mapper.Templates" acl-act="View" class="link-btn" asp-controller="TemplateVersions" asp-action="Detail" asp-route-id="@Model.TemplateVersionId">نسخهٔ @Model.VersionNo.ToPersianNumber()</a>
                    <span class="badge @Model.VersionStatus.BadgeClass()">@Model.VersionStatus.ToLabel()</span>
                </dd>
            </div>
            @if (Model.ImportBatchId.HasValue)
            {
                <div>
                    <dt>ایمپورت مبدأ</dt>
                    <dd>
                        <a acl-res="Mapper.Imports" acl-act="View" class="link-btn" asp-controller="Imports" asp-action="Detail" asp-route-id="@Model.ImportBatchId">@(Model.ImportFileName ?? $"IMP-{Model.ImportBatchId:0000}")</a>
                        @if (Model.ImportRowNumber.HasValue)
                        {
                            <span class="cell-sub">· سطر @((int)Model.ImportRowNumber.Value).ToPersianNumber()</span>
                        }
                    </dd>
                </div>
            }
            <div><dt>تاریخ ثبت</dt><dd class="nums">@Model.CreatedAt.ToJalali().ToPersianDigits()</dd></div>
            <div><dt>آخرین ویرایش</dt><dd class="nums">@(Model.UpdatedAt.HasValue ? Model.UpdatedAt.ToJalali().ToPersianDigits() : "—")</dd></div>
        </dl>
    </footer>
</article>

<partial name="_DeleteModal" />

@section Scripts {
    <script src="~/js/confirm-delete.js" asp-append-version="true"></script>
    <partial name="_RecordFormScripts" />
}
