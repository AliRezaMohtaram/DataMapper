@model Borc.DataMapper.Web.ViewModels.DataRecords.DataRecordIndexViewModel
@using Borc.DataMapper.Web.ViewModels.DataRecords
@using Borc.DataMapper.Domain.Records
@{
    ViewData["Title"] = "داده‌های ثبت‌شده";

    var result = Model.Result;
    var filter = Model.Filter;

    var errors = ViewData.ModelState.Values
        .SelectMany(v => v.Errors)
        .Select(e => e.ErrorMessage)
        .Where(m => !string.IsNullOrWhiteSpace(m))
        .ToList();

    var from = result.TotalCount == 0 ? 0 : (result.Page - 1) * result.PageSize + 1;
    var to = Math.Min(result.Page * result.PageSize, result.TotalCount);
    var pageSizes = new[] { 10, 20, 50, 100 };
    var hasFilter = !string.IsNullOrWhiteSpace(filter.Search) || filter.TemplateVersionId.HasValue
                    || filter.Source.HasValue || filter.ImportBatchId.HasValue;
}

<div class="panel card">
    <div class="panel-header">
        <h2>داده‌های ثبت‌شده</h2>

        <div class="summary-stats">
            <span>کل: <b>@result.TotalCount</b></span>
            @if (result.TotalCount > 0)
            {
                <span>نمایش: <b>@from</b> تا <b>@to</b></span>
            }
        </div>

        <a asp-action="Create" asp-route-versionId="@filter.TemplateVersionId" class="btn primary">+ ورود دستی داده</a>
    </div>

    @if (errors.Count > 0)
    {
        <div class="status error show">@string.Join(" — ", errors)</div>
    }

    <form method="get" asp-action="Index">
        <input type="hidden" name="pageSize" value="@result.PageSize" />
        <input type="hidden" name="importBatchId" value="@filter.ImportBatchId" />

        <div class="form-group">
            <label for="drSearch">جستجو در مقدارها:</label>
            <input type="text" id="drSearch" name="search" value="@filter.Search"
                   placeholder="بخشی از یکی از مقدارهای رکورد..." autocomplete="off">
        </div>

        <div class="form-group">
            <label for="drVersion">قالب و نسخه:</label>
            <select id="drVersion" name="templateVersionId">
                <option value="">همه</option>
                @foreach (var v in Model.Versions)
                {
                    <option value="@v.Id" selected="@(filter.TemplateVersionId == v.Id)">@v.Label</option>
                }
            </select>
        </div>

        <div class="form-group">
            <label for="drSource">منبع:</label>
            <select id="drSource" name="source">
                <option value="">همه</option>
                <option value="@RecordSource.Manual" selected="@(filter.Source == RecordSource.Manual)">ورود دستی</option>
                <option value="@RecordSource.Import" selected="@(filter.Source == RecordSource.Import)">ایمپورت</option>
            </select>
        </div>

        @if (filter.ImportBatchId.HasValue)
        {
            <div class="hint">فقط رکوردهای ایمپورت شمارهٔ @filter.ImportBatchId نمایش داده می‌شود.</div>
        }

        <div class="actions">
            <button type="submit" class="btn primary">اعمال فیلتر</button>
            <a asp-action="Index" asp-route-pageSize="@result.PageSize" class="btn ghost">پاکسازی فیلتر</a>
        </div>
    </form>
</div>

<div class="panel card">
    <div class="tscroll results-table-container">
        <table class="results-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>قالب</th>
                    <th>نسخه</th>
                    <th>منبع</th>
                    <th>خلاصهٔ داده</th>
                    <th>تاریخ ثبت</th>
                    <th>عملیات</th>
                </tr>
            </thead>
            <tbody>
            @if (result.Items.Count == 0)
            {
                <tr>
                    <td colspan="7" class="entries-empty">
                        @(hasFilter ? "رکوردی با این مشخصات پیدا نشد." : "هنوز دیتایی ثبت نشده است.")
                    </td>
                </tr>
            }
            else
            {
                foreach (var r in result.Items)
                {
                    <tr>
                        <td><a asp-action="Detail" asp-route-id="@r.Id">@r.Id</a></td>
                        <td>@r.TemplateName</td>
                        <td>نسخه @r.VersionNo</td>
                        <td>
                            <span class="mode-badge">@r.Source.ToLabel()</span>
                            @if (r.ImportBatchId.HasValue)
                            {
                                <a asp-controller="Imports" asp-action="Detail" asp-route-id="@r.ImportBatchId">#@r.ImportBatchId</a>
                            }
                        </td>
                        <td style="max-width:420px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="@r.Preview">@r.Preview</td>
                        <td dir="ltr">@r.CreatedAt.ToJalali()</td>
                        <td>
                            <div class="row-actions">
                                <a asp-action="Detail" asp-route-id="@r.Id" class="btn secondary low-padding"
                                   title="مشاهده" aria-label="مشاهده"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg></a>

                                <a asp-action="Edit" asp-route-id="@r.Id" class="btn primary low-padding"
                                   title="ویرایش" aria-label="ویرایش"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9" /><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z" /></svg></a>

                                <button type="button" class="btn danger low-padding" title="حذف" aria-label="حذف"
                                        data-delete-id="@r.Id" data-delete-name="رکورد @r.Id"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" /><path d="M10 11v6" /><path d="M14 11v6" /><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" /></svg></button>
                            </div>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>

    <div class="pagination">
        @if (result.HasPrevious)
        {
            <a class="btn ghost" asp-action="Index" asp-route-search="@filter.Search"
               asp-route-templateVersionId="@filter.TemplateVersionId" asp-route-source="@filter.Source"
               asp-route-importBatchId="@filter.ImportBatchId"
               asp-route-pageSize="@result.PageSize" asp-route-page="@(result.Page - 1)">قبلی</a>
        }
        else
        {
            <button type="button" class="btn ghost" disabled>قبلی</button>
        }

        <span>صفحه @result.Page از @Math.Max(1, result.TotalPages)</span>

        @if (result.HasNext)
        {
            <a class="btn ghost" asp-action="Index" asp-route-search="@filter.Search"
               asp-route-templateVersionId="@filter.TemplateVersionId" asp-route-source="@filter.Source"
               asp-route-importBatchId="@filter.ImportBatchId"
               asp-route-pageSize="@result.PageSize" asp-route-page="@(result.Page + 1)">بعدی</a>
        }
        else
        {
            <button type="button" class="btn ghost" disabled>بعدی</button>
        }

        <form method="get" asp-action="Index" style="display:inline">
            <input type="hidden" name="search" value="@filter.Search" />
            <input type="hidden" name="templateVersionId" value="@filter.TemplateVersionId" />
            <input type="hidden" name="source" value="@filter.Source" />
            <input type="hidden" name="importBatchId" value="@filter.ImportBatchId" />
            <label class="rpp-label">ردیف در صفحه:
                <select name="pageSize" onchange="this.form.submit()">
                    @foreach (var size in pageSizes)
                    {
                        <option value="@size" selected="@(result.PageSize == size)">@size</option>
                    }
                </select>
            </label>
        </form>
    </div>
</div>

<partial name="_DeleteModal" />

@section Scripts {
    <script src="~/js/confirm-delete.js" asp-append-version="true"></script>
}
