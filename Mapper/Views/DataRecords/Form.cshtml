@model Borc.DataMapper.Web.ViewModels.DataRecords.RecordFormPageViewModel
@{
    var isEdit = Model.RecordId.HasValue;
    ViewData["Title"] = isEdit ? $"ویرایش رکورد {Model.RecordId}" : $"ورود دستی داده - {Model.TemplateName}";
    ViewData["Subtitle"] = $"{Model.TemplateName} · نسخهٔ {Model.VersionNo.ToPersianNumber()}";
    ViewData["Crumbs"] = new[] { new Borc.DataMapper.Web.ViewModels.Crumb($"{Model.TemplateName} · نسخهٔ {Model.VersionNo.ToPersianNumber()}", Url.Action("Index", "DataRecords", new { templateVersionId = Model.TemplateVersionId })) };
}

@section TopbarActions {
    @if (isEdit)
    {
        <a acl-res="Mapper.DataRecords" acl-act="View" class="btn btn-ghost" asp-action="Detail" asp-route-id="@Model.RecordId"><svg class="ico"><use href="#i-chev-right" /></svg><span class="lbl">بازگشت به رکورد</span></a>
    }
    else
    {
        <a acl-res="Mapper.DataRecords" acl-act="View" class="btn btn-ghost" asp-action="Index" asp-route-templateVersionId="@Model.TemplateVersionId"><svg class="ico"><use href="#i-chev-right" /></svg><span class="lbl">رکوردهای این نسخه</span></a>
    }
}

<div class="modal-page">
    <partial name="_RecordForm" model="Model" />
</div>

@if (Model.Recent is not null)
{
    <article class="card rise" id="rfRecent" style="--i:1;margin-top:1rem">
        <partial name="_RecentRecords" model="Model.Recent" />
    </article>
}

@section Scripts {
    <partial name="_RecordFormScripts" />
}
