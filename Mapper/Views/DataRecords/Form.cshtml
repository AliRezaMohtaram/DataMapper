@model Borc.DataMapper.Web.ViewModels.DataRecords.RecordFormPageViewModel
@{
    var isEdit = Model.RecordId.HasValue;
    ViewData["Title"] = isEdit ? $"ویرایش رکورد {Model.RecordId}" : $"ورود دستی داده - {Model.TemplateName}";
    ViewData["Subtitle"] = $"{Model.TemplateName} · نسخهٔ {Model.VersionNo.ToPersianNumber()}";
}

@Html.AntiForgeryToken()

@section TopbarActions {
    @if (isEdit)
    {
        <a class="btn btn-ghost" asp-action="Detail" asp-route-id="@Model.RecordId"><svg class="ico"><use href="#i-chev-right" /></svg><span class="lbl">بازگشت به رکورد</span></a>
    }
    else
    {
        <a class="btn btn-ghost" asp-action="Index" asp-route-templateVersionId="@Model.TemplateVersionId"><svg class="ico"><use href="#i-chev-right" /></svg><span class="lbl">رکوردهای این نسخه</span></a>
    }
}

@* بدنهٔ فرم را record-form.js با موتور Layout داخل #rfHost می‌سازد؛ این صفحه فقط قاب و دکمه‌ها را دارد. *@
<article class="card rise">
    <header class="card-head">
        <div class="card-title">
            <span class="card-ico" style="background:var(--success-soft);color:var(--success)"><svg class="ico"><use href="#i-pen" /></svg></span>
            <div>
                @(isEdit ? $"ویرایش رکورد {Model.RecordId}" : "رکورد جدید")
                <div class="card-sub">@Model.TemplateName · نسخهٔ @Model.VersionNo.ToPersianNumber() — فیلدهای ستاره‌دار الزامی‌اند</div>
            </div>
        </div>
    </header>

    <div class="card-body">
        <div id="rfHost" class="rf-host"></div>
    </div>

    <footer class="card-foot" style="justify-content:flex-end">
        @if (isEdit)
        {
            <a class="btn btn-quiet" asp-action="Detail" asp-route-id="@Model.RecordId">انصراف</a>
        }
        else
        {
            <button type="button" id="rfSaveNew" class="btn btn-ghost"><svg class="ico"><use href="#i-plus" /></svg>ذخیره و رکورد جدید</button>
        }
        <button type="button" id="rfSave" class="btn btn-primary"><svg class="ico"><use href="#i-check" /></svg>ذخیره رکورد</button>
    </footer>
</article>

<partial name="_ConfirmModal" />

<script id="rfData" type="application/json">@Html.Raw(Model.DataJson)</script>

@section Scripts {
    <script src="~/js/ui.js" asp-append-version="true"></script>
    <script src="~/js/jalali-picker.js" asp-append-version="true"></script>
    <script src="~/js/combobox.js" asp-append-version="true"></script>
    <script src="~/js/layout-designer.js" asp-append-version="true"></script>
    <script src="~/js/record-form.js" asp-append-version="true"></script>
}
