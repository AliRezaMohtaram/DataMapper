@model Borc.DataMapper.Web.ViewModels.Imports.ImportIndexViewModel
@using Borc.DataMapper.Web.ViewModels.Imports
@using Borc.DataMapper.Web.ViewModels.Dashboard
@using Borc.DataMapper.Domain.Imports
@{
    ViewData["Title"] = "ایمپورت داده";

    var result = Model.Result;
    var filter = Model.Filter;
    var filtering = !string.IsNullOrWhiteSpace(filter.Search) || filter.Status.HasValue;

    var errors = ViewData.ModelState.Values
        .SelectMany(v => v.Errors)
        .Select(e => e.ErrorMessage)
        .Where(m => !string.IsNullOrWhiteSpace(m))
        .ToList();

    var from = result.TotalCount == 0 ? 0 : (result.Page - 1) * result.PageSize + 1;
    var to = Math.Min(result.Page * result.PageSize, result.TotalCount);
    var pageSizes = new[] { 10, 20, 50, 100 };

    ViewData["Subtitle"] = $"{result.TotalCount.ToPersianNumber()} ایمپورت · بارگذاری، تطبیق، اعتبارسنجی و ثبت فایل‌های Excel";
}

@if (errors.Count > 0)
{
    <div class="callout tone-danger" role="alert" style="margin-bottom:1rem">
        <svg class="ico"><use href="#i-alert" /></svg><div>@string.Join(" — ", errors)</div>
    </div>
}

<article class="card rise">
    <header class="card-head">
        <div class="card-title">
            <span class="card-ico"><svg class="ico"><use href="#i-upload" /></svg></span>
            <div>ایمپورت‌ها<div class="card-sub">هر ایمپورت پس از تطبیق ستون‌ها اعتبارسنجی و سپس ثبت نهایی می‌شود.</div></div>
        </div>
    </header>

    <div class="toolbar">
        <form method="get" asp-action="Index" role="search">
            <input type="hidden" name="pageSize" value="@result.PageSize" />
            <div class="input-wrap">
                <svg class="ico"><use href="#i-search" /></svg>
                <input class="input" type="search" name="search" value="@filter.Search" placeholder="جستجو در نام فایل یا قالب…" aria-label="جستجو در ایمپورت‌ها" autocomplete="off" />
            </div>
            <select class="select" name="status" aria-label="وضعیت" onchange="this.form.requestSubmit()">
                <option value="">همهٔ وضعیت‌ها</option>
                @foreach (var st in Enum.GetValues<ImportBatchStatus>())
                {
                    <option value="@st" selected="@(filter.Status == st)">@st.ShortLabel()</option>
                }
            </select>
            <button type="submit" class="btn btn-ghost"><svg class="ico"><use href="#i-search" /></svg>جستجو</button>
            @if (filtering)
            {
                <a class="btn btn-quiet" asp-action="Index" asp-route-pageSize="@result.PageSize"><svg class="ico"><use href="#i-x" /></svg>پاک کردن فیلتر</a>
            }
        </form>
    </div>

    @if (result.Items.Count == 0)
    {
        <div class="empty">
            @if (filtering)
            {
                <p>ایمپورتی با این مشخصات پیدا نشد.</p>
                <a class="btn btn-ghost btn-sm" style="margin-top:.8rem" asp-action="Index">پاک کردن فیلتر</a>
            }
            else
            {
                <p>هنوز فایلی ایمپورت نشده است.</p>
                <a class="btn btn-primary btn-sm" style="margin-top:.8rem" asp-action="Upload" data-modal><svg class="ico"><use href="#i-upload" /></svg>اولین ایمپورت</a>
            }
        </div>
    }
    else
    {
        <div class="tbl-wrap">
            <table class="tbl">
                <thead><tr><th>فایل</th><th>قالب</th><th>سطرها</th><th>وضعیت</th><th>آپلود</th><th></th></tr></thead>
                <tbody>
                    @foreach (var b in result.Items)
                    {
                        var kind = DashboardUi.FileKind(b.FileName);
                        var checkedRows = b.ValidRows + b.InvalidRows;
                        var okPct = checkedRows == 0 ? 0 : 100.0 * b.ValidRows / checkedRows;
                        <tr>
                            <td>
                                <div class="file-cell">
                                    <span class="file-ico@(kind == "CSV" ? " csv" : "")">@kind</span>
                                    <div>
                                        <a class="cell-main" asp-action="Detail" asp-route-id="@b.Id">@b.FileName</a>
                                        <div class="cell-sub"><span class="code">IMP-@b.Id.ToString("0000")</span></div>
                                    </div>
                                </div>
                            </td>
                            <td><div class="cell-main">@b.TemplateName</div><div class="cell-sub">نسخهٔ @b.VersionNo.ToPersianNumber()</div></td>
                            <td>
                                <div class="rowbar">
                                    <div class="rowbar-track">
                                        @if (checkedRows > 0)
                                        {
                                            <span class="ok" style="width:@okPct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span>
                                            <span class="bad" style="width:@((100 - okPct).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></span>
                                        }
                                    </div>
                                    <div class="rowbar-meta">
                                        <span>@b.TotalRows.ToPersianNumber() سطر</span>
                                        @if (b.InvalidRows > 0)
                                        {
                                            <span class="bad">@b.InvalidRows.ToPersianNumber() نامعتبر</span>
                                        }
                                        else if (checkedRows > 0)
                                        {
                                            <span>بدون خطا</span>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge @b.Status.BadgeClass()" title="@b.Status.ToLabel()">@b.Status.ShortLabel()</span></td>
                            <td class="cell-sub">@b.CreatedAt.ToRelative()</td>
                            <td>
                                <div class="row-actions">
                                    <a class="icon-btn sm primary" asp-action="Detail" asp-route-id="@b.Id" title="جزئیات" aria-label="جزئیات @b.FileName"><svg class="ico"><use href="#i-eye" /></svg></a>
                                    @if (b.Status != ImportBatchStatus.Imported)
                                    {
                                        <button class="icon-btn sm danger" type="button" data-delete-id="@b.Id" data-delete-name="@b.FileName" title="حذف" aria-label="حذف @b.FileName"><svg class="ico"><use href="#i-trash" /></svg></button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (result.TotalCount > 0)
    {
        <footer class="card-foot">
            <span>@from.ToPersianNumber() تا @to.ToPersianNumber() از @result.TotalCount.ToPersianNumber()</span>
            <nav class="pager" aria-label="صفحه‌بندی">
                @if (result.HasPrevious)
                {
                    <a asp-action="Index" asp-route-search="@filter.Search" asp-route-status="@filter.Status" asp-route-pageSize="@result.PageSize" asp-route-page="@(result.Page - 1)" rel="prev" aria-label="صفحه قبل"><svg class="ico"><use href="#i-chev-right" /></svg></a>
                }
                else
                {
                    <span aria-disabled="true"><svg class="ico"><use href="#i-chev-right" /></svg></span>
                }
                <span class="pager-now" aria-current="page">صفحه @result.Page.ToPersianNumber() از @Math.Max(1, result.TotalPages).ToPersianNumber()</span>
                @if (result.HasNext)
                {
                    <a asp-action="Index" asp-route-search="@filter.Search" asp-route-status="@filter.Status" asp-route-pageSize="@result.PageSize" asp-route-page="@(result.Page + 1)" rel="next" aria-label="صفحه بعد"><svg class="ico"><use href="#i-chev-left" /></svg></a>
                }
                else
                {
                    <span aria-disabled="true"><svg class="ico"><use href="#i-chev-left" /></svg></span>
                }
            </nav>
            <form method="get" asp-action="Index" class="page-size">
                <input type="hidden" name="search" value="@filter.Search" />
                <input type="hidden" name="status" value="@filter.Status" />
                <label for="pageSize">ردیف در صفحه</label>
                <select class="select" id="pageSize" name="pageSize" onchange="this.form.submit()">
                    @foreach (var size in pageSizes)
                    {
                        <option value="@size" selected="@(result.PageSize == size)">@size.ToPersianNumber()</option>
                    }
                </select>
            </form>
        </footer>
    }
</article>

<partial name="_DeleteModal" />

@section Scripts {
    <script src="~/js/confirm-delete.js" asp-append-version="true"></script>
}
