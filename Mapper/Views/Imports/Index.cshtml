@model Borc.DataMapper.Web.ViewModels.Imports.ImportIndexViewModel
@using Borc.DataMapper.Web.ViewModels.Imports
@using Borc.DataMapper.Domain.Imports
@{
    ViewData["Title"] = "ایمپورت داده";

    var result = Model.Result;
    var filter = Model.Filter;

    var errors = ViewData.ModelState.Values
        .SelectMany(v => v.Errors)
        .Select(e => e.ErrorMessage)
        .Where(m => !string.IsNullOrWhiteSpace(m))
        .ToList();

    var from = result.TotalCount == 0 ? 0 : (result.Page - 1) * result.PageSize + 1;
    var to = Math.Min(result.Page * result.PageSize, result.TotalCount);
    var pageSizes = new[] { 10, 20, 50, 100 };
}

<div class="panel card">
    <div class="panel-header">
        <h2>ایمپورت داده از Excel</h2>

        <div class="summary-stats">
            <span>کل: <b>@result.TotalCount</b></span>
            @if (result.TotalCount > 0)
            {
                <span>نمایش: <b>@from</b> تا <b>@to</b></span>
            }
        </div>

        <a asp-action="Upload" class="btn primary">+ آپلود فایل جدید</a>
    </div>

    @if (errors.Count > 0)
    {
        <div class="status error show">@string.Join(" — ", errors)</div>
    }

    <form method="get" asp-action="Index">
        <input type="hidden" name="pageSize" value="@result.PageSize" />

        <div class="form-group">
            <label for="impSearch">جستجو (نام فایل یا قالب):</label>
            <input type="text" id="impSearch" name="search" value="@filter.Search" autocomplete="off"
                   placeholder="جستجو در ایمپورت‌ها..." />
        </div>

        <div class="form-group">
            <label for="impStatus">وضعیت:</label>
            <select id="impStatus" name="status">
                <option value="">همه وضعیت‌ها</option>
                @foreach (var st in Enum.GetValues<ImportBatchStatus>())
                {
                    <option value="@st" selected="@(filter.Status == st)">@st.ToLabel()</option>
                }
            </select>
        </div>

        <div class="actions">
            <button type="submit" class="btn primary">جستجو</button>
            <a asp-action="Index" asp-route-pageSize="@result.PageSize" class="btn ghost">پاکسازی فیلتر</a>
        </div>
    </form>
</div>

<div class="panel card">
    <div class="tscroll results-table-container">
        <table class="results-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>فایل</th>
                    <th>قالب</th>
                    <th>سطرها</th>
                    <th>معتبر</th>
                    <th>نامعتبر</th>
                    <th>وضعیت</th>
                    <th>تاریخ آپلود</th>
                    <th>عملیات</th>
                </tr>
            </thead>
            <tbody>
            @if (result.Items.Count == 0)
            {
                <tr><td colspan="9" class="entries-empty">هنوز فایلی آپلود نشده است.</td></tr>
            }
            else
            {
                foreach (var b in result.Items)
                {
                    <tr>
                        <td>@b.Id</td>
                        <td dir="ltr">@b.FileName</td>
                        <td>@b.TemplateName — نسخه @b.VersionNo</td>
                        <td>@b.TotalRows</td>
                        <td>@b.ValidRows</td>
                        <td>@b.InvalidRows</td>
                        <td><span class="mode-badge">@b.Status.ToLabel()</span></td>
                        <td dir="ltr">@b.CreatedAt.ToJalali()</td>
                        <td>
                            <div class="row-actions">
                                <a asp-action="Detail" asp-route-id="@b.Id" class="btn primary low-padding"
                                   title="مشاهده" aria-label="مشاهده">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2"
                                         stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z" />
                                        <circle cx="12" cy="12" r="3" />
                                    </svg>
                                </a>

                                @if (b.Status != ImportBatchStatus.Imported)
                                {
                                    <button type="button" class="btn danger low-padding" title="حذف" aria-label="حذف"
                                            data-delete-id="@b.Id" data-delete-name="@b.FileName">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                             fill="none" stroke="currentColor" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="3 6 5 6 21 6" />
                                            <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                                            <path d="M10 11v6" />
                                            <path d="M14 11v6" />
                                            <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" />
                                        </svg>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>

    <div class="pagination">
        @if (result.HasPrevious)
        {
            <a class="btn ghost" asp-action="Index" asp-route-search="@filter.Search" asp-route-status="@filter.Status"
               asp-route-pageSize="@result.PageSize" asp-route-page="@(result.Page - 1)">قبلی</a>
        }
        else
        {
            <button type="button" class="btn ghost" disabled>قبلی</button>
        }

        <span>صفحه @result.Page از @Math.Max(1, result.TotalPages)</span>

        @if (result.HasNext)
        {
            <a class="btn ghost" asp-action="Index" asp-route-search="@filter.Search" asp-route-status="@filter.Status"
               asp-route-pageSize="@result.PageSize" asp-route-page="@(result.Page + 1)">بعدی</a>
        }
        else
        {
            <button type="button" class="btn ghost" disabled>بعدی</button>
        }

        <form method="get" asp-action="Index" style="display:inline">
            <input type="hidden" name="search" value="@filter.Search" />
            @if (filter.Status.HasValue)
            {
                <input type="hidden" name="status" value="@filter.Status" />
            }
            <label class="rpp-label">ردیف در صفحه:
                <select name="pageSize" onchange="this.form.submit()">
                    @foreach (var size in pageSizes)
                    {
                        <option value="@size" selected="@(result.PageSize == size)">@size</option>
                    }
                </select>
            </label>
        </form>
    </div>
</div>

<partial name="_DeleteModal" />

@section Scripts {
    <script src="~/js/confirm-delete.js" asp-append-version="true"></script>
}
