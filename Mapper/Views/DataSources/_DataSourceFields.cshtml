@model Borc.DataMapper.Web.ViewModels.DataSources.DataSourceFormViewModel
@using Borc.DataMapper.Domain.DataSources
@* بخش‌های مخصوص هر نوع منبع داده؛ datasource-form.js فقط بخش نوع انتخاب‌شده را نشان می‌دهد
   و کنترل‌های بخش‌های پنهان را غیرفعال می‌کند تا ارسال نشوند. *@
@{
    string Hidden(DataSourceType t) => Model.SourceType == t ? "" : "hidden";
    string Invalid(string key) => ViewData.ModelState[key]?.Errors.Count > 0 ? " field-invalid" : "";
}

<section data-ds-type="@DataSourceType.StaticList" @Hidden(DataSourceType.StaticList)>
    <div class="fieldset-title">گزینه‌ها</div>
    <div class="field@(Invalid(nameof(Model.ItemsText)))">
        <label class="label" asp-for="ItemsText">هر خط یک گزینه</label>
        <textarea class="textarea" asp-for="ItemsText" rows="8" style="min-height:9rem"
                  placeholder="مقدار | عنوان نمایشی&#10;DRILL | حفاری&#10;PROD | تولید"></textarea>
        <span class="field-error" asp-validation-for="ItemsText"></span>
        <span class="hint">
            هر خط: «مقدار» یا «مقدار | عنوان». مقدار در داده ذخیره می‌شود و عنوان به کاربر نمایش داده می‌شود؛
            بدون عنوان، خود مقدار نمایش داده می‌شود. حداکثر ۵۰۰۰ گزینه.
        </span>
    </div>
</section>

<section data-ds-type="@DataSourceType.File" @Hidden(DataSourceType.File)>
    <div class="callout tone-success" style="margin-top:1.2rem">
        <svg class="ico"><use href="#i-sheet" /></svg>
        <div>
            پس از ذخیره، فایل Excel (xlsx) یا CSV را بارگذاری و ستون <b>مقدار</b> و ستون <b>عنوان نمایشی</b> را انتخاب می‌کنید.
            بارگذاری دوبارهٔ فایل، گزینه‌های قبلی را جایگزین می‌کند.
        </div>
    </div>
</section>

<section data-ds-type="@DataSourceType.Template" @Hidden(DataSourceType.Template)>
    <div class="fieldset-title">قالب منبع</div>
    <div class="form-grid cols-3">
        <div class="field@(Invalid(nameof(Model.TemplateId)))">
            <label class="label" asp-for="TemplateId">قالب</label>
            <select class="select" asp-for="TemplateId" data-ds-template data-selected="@Model.TemplateId">
                <option value="">— انتخاب کنید —</option>
            </select>
            <span class="field-error" asp-validation-for="TemplateId"></span>
        </div>
        <div class="field@(Invalid(nameof(Model.ValueKey)))">
            <label class="label" asp-for="ValueKey">فیلد مقدار</label>
            <select class="select" asp-for="ValueKey" data-ds-value data-selected="@Model.ValueKey">
                <option value="">— ابتدا قالب —</option>
            </select>
            <span class="field-error" asp-validation-for="ValueKey"></span>
        </div>
        <div class="field@(Invalid(nameof(Model.DisplayKey)))">
            <label class="label" asp-for="DisplayKey">فیلد نمایشی</label>
            <select class="select" asp-for="DisplayKey" data-ds-display data-selected="@Model.DisplayKey">
                <option value="">— ابتدا قالب —</option>
            </select>
            <span class="field-error" asp-validation-for="DisplayKey"></span>
        </div>
    </div>
    <p class="hint" style="margin-top:.6rem">
        فقط قالب‌های دارای نسخهٔ منتشرشده. گزینه‌ها از رکوردهای ثبت‌شدهٔ همان قالب ساخته می‌شوند؛
        مقدار و نمایش می‌توانند یک فیلد باشند (مثلاً مقدار = «کد پیمانکار»، نمایش = «نام پیمانکار»).
    </p>
</section>

<section data-ds-type="@DataSourceType.Api" @Hidden(DataSourceType.Api)>
    <div class="fieldset-title">سرویس API</div>
    <div class="form-grid">
        <div class="field span-2@(Invalid(nameof(Model.ApiUrl)))">
            <label class="label" asp-for="ApiUrl">آدرس API (GET، خروجی JSON)</label>
            <div class="input-wrap">
                <svg class="ico"><use href="#i-cloud" /></svg>
                <input class="input ltr" asp-for="ApiUrl" autocomplete="off" placeholder="https://example.com/api/contractors" />
            </div>
            <span class="field-error" asp-validation-for="ApiUrl"></span>
        </div>
        <div class="field span-2@(Invalid(nameof(Model.ApiItemsPath)))">
            <label class="label" asp-for="ApiItemsPath">مسیر آرایه در پاسخ (اختیاری)</label>
            <input class="input ltr" asp-for="ApiItemsPath" autocomplete="off" placeholder="data.items" />
            <span class="hint">اگر پاسخ خودش آرایه است خالی بگذارید؛ برای <span class="code-chip">{"data":{"items":[…]}}</span> بنویسید <span class="code-chip">data.items</span>.</span>
        </div>
        <div class="field@(Invalid(nameof(Model.ApiValueKey)))">
            <label class="label" asp-for="ApiValueKey">نام فیلد مقدار</label>
            <input class="input ltr" asp-for="ApiValueKey" autocomplete="off" placeholder="id" />
        </div>
        <div class="field@(Invalid(nameof(Model.ApiDisplayKey)))">
            <label class="label" asp-for="ApiDisplayKey">نام فیلد نمایشی</label>
            <input class="input ltr" asp-for="ApiDisplayKey" autocomplete="off" placeholder="name" />
        </div>
    </div>
    <p class="hint" style="margin-top:.6rem">
        اگر عضوهای آرایه خودشان متن یا عدد هستند، هر دو نام فیلد خالی بماند. پاسخ ۵ دقیقه نگه‌داری می‌شود و حداکثر ۲ مگابایت است؛
        اتصال به آدرس‌های محلی و شبکهٔ داخلی به‌صورت پیش‌فرض مسدود است.
    </p>
</section>
