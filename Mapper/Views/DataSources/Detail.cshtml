@model Borc.DataMapper.Application.DataSources.GetDataSource.DataSourceDetailDto
@using Borc.DataMapper.Web.ViewModels
@using Borc.DataMapper.Web.ViewModels.Dashboard
@using Borc.DataMapper.Web.ViewModels.DataSources
@using Borc.DataMapper.Domain.DataSources
@{
    ViewData["Title"] = Model.Name;
    ViewData["Subtitle"] = $"منبع داده {Model.Code} · {Model.SourceType.ToLabel()}";
    var here = Context.Request.Path.ToString();
}

@section TopbarActions {
    <a acl-res="Mapper.DataSources" acl-act="View" class="btn btn-ghost" asp-action="Index"><svg class="ico"><use href="#i-chev-right" /></svg><span class="lbl">همهٔ منابع داده</span></a>
}

@if (Model.SourceType == DataSourceType.File && Model.ItemCount == 0)
{
    <div class="callout tone-warning" style="margin-bottom:1rem">
        <svg class="ico"><use href="#i-alert" /></svg>
        <div>هنوز فایلی برای این منبع بارگذاری نشده است؛ تا بارگذاری نشود، فیلدهای وابسته گزینه‌ای ندارند.</div>
    </div>
}

<div class="split">

    <article class="card rise">
        <header class="card-head">
            <div class="card-title">
                <span class="card-ico"><svg class="ico"><use href="#i-list" /></svg></span>
                <div>
                    گزینه‌ها
                    <div class="card-sub">
                        @switch (Model.SourceType)
                        {
                            case DataSourceType.StaticList:
                                <text>@Model.ItemCount.ToPersianNumber() گزینه ثبت شده است؛ برای تغییر، «ویرایش» را بزنید.</text>
                                break;
                            case DataSourceType.File:
                                if (Model.ItemCount > 0)
                                {
                                    <text>@Model.ItemCount.ToPersianNumber() گزینه از فایل «@Model.FileName» (مقدار: «@Model.FileValueColumn»@(string.IsNullOrEmpty(Model.FileDisplayColumn) ? "" : $"، نمایشی: «{Model.FileDisplayColumn}»"))</text>
                                }
                                else
                                {
                                    <text>بعد از بارگذاری فایل، ستون مقدار و ستون نمایشی را انتخاب می‌کنید.</text>
                                }
                                break;
                            case DataSourceType.Template:
                                <text>هر بار از رکوردهای ثبت‌شدهٔ قالب خوانده می‌شود (حداکثر ۵۰۰۰ رکورد آخر).</text>
                                break;
                            case DataSourceType.Api:
                                <text>از سرویس خارجی خوانده و ۵ دقیقه نگه‌داری می‌شود.</text>
                                break;
                        }
                    </div>
                </div>
            </div>
            <div class="row" style="gap:.5rem">
                @if (Model.SourceType == DataSourceType.File)
                {
                    <a acl-res="Mapper.DataSources" acl-act="Edit" class="btn btn-soft btn-sm" asp-action="UploadFile" asp-route-id="@Model.Id"><svg class="ico"><use href="#i-upload" /></svg>@(Model.ItemCount == 0 ? "بارگذاری فایل" : "بارگذاری فایل جدید")</a>
                }
                <button type="button" id="dsPreviewBtn" class="btn btn-ghost btn-sm"
                        data-url="@Url.Action("Options", "DataSources", new { id = Model.Id })"><svg class="ico"><use href="#i-eye" /></svg>نمایش نمونه</button>
            </div>
        </header>

        <div id="dsPreviewOut">
            <div class="empty">«نمایش نمونه» ۲۰ گزینهٔ اول را همان‌طور که در فرم‌ها دیده می‌شوند نشان می‌دهد@(Model.SourceType == DataSourceType.Api ? " و اتصال و تنظیمات مسیر را بررسی می‌کند" : "").</div>
        </div>
    </article>

    <aside class="split-side">
        <article class="card rise" style="--i:1">
            <div class="card-body">
                <div class="row" style="justify-content:space-between;align-items:flex-start">
                    <div class="hero-title">@Model.Name</div>
                    <span class="badge @(Model.IsActive ? "st-active" : "st-inactive")">@(Model.IsActive ? "فعال" : "غیرفعال")</span>
                </div>
                <div class="row" style="gap:.5rem;margin-top:.3rem">
                    <span class="code">@Model.Code</span>
                    <span class="tag @DashboardUi.Tone(Model.SourceType)"><svg class="ico" style="width:.8rem;height:.8rem"><use href="#@DashboardUi.Icon(Model.SourceType)" /></svg>@Model.SourceType.ToLabel()</span>
                </div>

                <dl class="dl stacked" style="margin-top:1rem">
                    <div><dt>واحد سازمانی</dt><dd><partial name="_OrgUnitBadge" model="(Borc.DataMapper.Application.OrgUnits.OrgUnitOwnedKind.DataSource, Model.Id)" /></dd></div>

                    @if (Model.SourceType == DataSourceType.Template)
                    {
                        <div>
                            <dt>قالب منبع</dt>
                            <dd>
                                @if (Model.TemplateId.HasValue)
                                {
                                    <a acl-res="Mapper.Templates" acl-act="View" class="link-btn" asp-controller="Templates" asp-action="Detail" asp-route-id="@Model.TemplateId">@(Model.TemplateName ?? $"#{Model.TemplateId}")</a>
                                }
                                else
                                {
                                    <text>—</text>
                                }
                            </dd>
                        </div>
                        <div><dt>فیلد مقدار / نمایشی</dt><dd class="mono">@Model.ValueKey / @Model.DisplayKey</dd></div>
                    }

                    @if (Model.SourceType == DataSourceType.Api)
                    {
                        <div><dt>آدرس API</dt><dd class="mono" style="overflow-wrap:anywhere">@Model.ApiUrl</dd></div>
                        <div><dt>مسیر آرایه</dt><dd class="mono">@(string.IsNullOrEmpty(Model.ApiItemsPath) ? "(ریشه)" : Model.ApiItemsPath)</dd></div>
                        <div><dt>فیلد مقدار / نمایشی</dt><dd class="mono">@(Model.ApiValueKey ?? "—") / @(Model.ApiDisplayKey ?? "—")</dd></div>
                    }

                    @if (Model.SourceType == DataSourceType.File && Model.FileImportedAt.HasValue)
                    {
                        <div><dt>آخرین بارگذاری</dt><dd class="nums">@Model.FileImportedAt.ToJalali().ToPersianDigits()</dd></div>
                    }

                    @if (Model.SourceType is DataSourceType.StaticList or DataSourceType.File)
                    {
                        <div><dt>تعداد گزینه</dt><dd class="nums">@Model.ItemCount.ToPersianNumber()</dd></div>
                    }

                    <div><dt>استفاده در فیلدهای قالب</dt><dd class="nums">@Model.UsedByFieldCount.ToPersianNumber()</dd></div>
                    <div><dt>تاریخ ایجاد</dt><dd class="nums">@Model.CreatedAt.ToJalali().ToPersianDigits()</dd></div>
                    <div><dt>آخرین ویرایش</dt><dd class="nums">@Model.UpdatedAt.ToJalali().ToPersianDigits()</dd></div>
                </dl>
            </div>

            <div class="card-foot" style="display:block">
                <div class="action-stack">
                    <a acl-res="Mapper.DataSources" acl-act="Edit" class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id" asp-route-returnUrl="@here" data-modal><svg class="ico"><use href="#i-edit" /></svg>ویرایش مشخصات</a>

                    <form acl-res="Mapper.DataSources" acl-act="Edit" asp-action="SetActive" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="isActive" value="@((!Model.IsActive).ToString().ToLowerInvariant())" />
                        <input type="hidden" name="returnTo" value="detail" />
                        <button type="submit" class="btn btn-ghost"><svg class="ico"><use href="#@(Model.IsActive ? "i-x" : "i-check")" /></svg>@(Model.IsActive ? "غیرفعال‌سازی" : "فعال‌سازی")</button>
                    </form>

                    <div class="dd-sep"></div>
                    <button type="button" class="btn btn-danger-soft" data-delete-id="@Model.Id" data-delete-name="@Model.Name">
                        <svg class="ico"><use href="#i-trash" /></svg>حذف منبع داده
                    </button>
                </div>
            </div>
        </article>
    </aside>
</div>

<partial name="_DeleteModal" />

@section Scripts {
    <script src="~/js/confirm-delete.js" asp-append-version="true"></script>
    <script src="~/js/datasource-preview.js" asp-append-version="true"></script>
}
