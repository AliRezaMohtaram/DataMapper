@model Borc.DataMapper.Web.ViewModels.DataSources.DataSourceFormViewModel
@using Borc.DataMapper.Web.ViewModels.DataSources
@using Borc.DataMapper.Domain.DataSources
@{
    ViewData["Title"] = "منبع داده جدید";

    var modelErrors = ViewData.ModelState
        .Where(kv => string.IsNullOrEmpty(kv.Key))
        .SelectMany(kv => kv.Value!.Errors)
        .Select(e => e.ErrorMessage)
        .Where(m => !string.IsNullOrWhiteSpace(m))
        .ToList();
}

<div class="panel card">
    <div class="panel-header">
        <h2>منبع داده جدید</h2>
    </div>

    @if (modelErrors.Count > 0)
    {
        <div class="status error show">@string.Join(" — ", modelErrors)</div>
    }

    <form asp-action="Create" method="post" id="dsForm">
        <div class="form-group">
            <label asp-for="Code">کد منبع داده (انگلیسی):</label>
            <input asp-for="Code" dir="ltr" autocomplete="off" placeholder="مثلاً CONTRACTORS" />
            <span asp-validation-for="Code" style="color:var(--danger);font-size:12px"></span>
            <div class="hint">فقط حروف انگلیسی، عدد، _ و -. کد و نوع پس از ایجاد قابل تغییر نیست.</div>
        </div>

        <div class="form-group">
            <label asp-for="Name">نام منبع داده:</label>
            <input asp-for="Name" autocomplete="off" />
            <span asp-validation-for="Name" style="color:var(--danger);font-size:12px"></span>
        </div>

        <div class="form-group">
            <label asp-for="SourceType">نوع منبع:</label>
            <select asp-for="SourceType">
                @foreach (var t in new[] { DataSourceType.StaticList, DataSourceType.File, DataSourceType.Template, DataSourceType.Api })
                {
                    <option value="@t" selected="@(Model.SourceType == t)">@t.ToLabel() — @t.Describe()</option>
                }
            </select>
        </div>

        <partial name="_DataSourceFields" model="Model" />

        <div class="actions">
            <button type="submit" class="btn primary">ذخیره منبع داده</button>
            <a asp-action="Index" class="btn ghost">انصراف</a>
        </div>
    </form>
</div>

<script id="dsLookups" type="application/json">@Html.Raw(Model.LookupsJson)</script>

@section Scripts {
    <script src="~/js/datasource-form.js" asp-append-version="true"></script>
}
