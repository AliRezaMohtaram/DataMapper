@model Borc.DataMapper.Web.ViewModels.DataSources.DataSourceIndexViewModel
@using Borc.DataMapper.Web.ViewModels
@using Borc.DataMapper.Web.ViewModels.Dashboard
@using Borc.DataMapper.Web.ViewModels.DataSources
@{
    ViewData["Title"] = "منابع داده";

    var result = Model.Result;
    var filter = Model.Filter;
    var searching = !string.IsNullOrWhiteSpace(filter.Search);
    var here = Context.Request.Path + Context.Request.QueryString;

    var errors = ViewData.ModelState.Values
        .SelectMany(v => v.Errors)
        .Select(e => e.ErrorMessage)
        .Where(m => !string.IsNullOrWhiteSpace(m))
        .ToList();

    var from = result.TotalCount == 0 ? 0 : (result.Page - 1) * result.PageSize + 1;
    var to = Math.Min(result.Page * result.PageSize, result.TotalCount);
    var pageSizes = new[] { 10, 20, 50, 100 };

    ViewData["Subtitle"] = $"{result.TotalCount.ToPersianNumber()} منبع · گزینه‌های فیلدهای انتخابی قالب‌ها";
}

@section TopbarActions {
    <a acl-res="Mapper.DataSources" acl-act="Create" class="btn btn-soft" asp-action="Create" data-modal><svg class="ico"><use href="#i-plus" /></svg><span class="lbl">منبع داده جدید</span></a>
}

@if (errors.Count > 0)
{
    <div class="callout tone-danger" role="alert" style="margin-bottom:1rem">
        <svg class="ico"><use href="#i-alert" /></svg><div>@string.Join(" — ", errors)</div>
    </div>
}

<article class="card rise">
    <header class="card-head">
        <div class="card-title">
            <span class="card-ico"><svg class="ico"><use href="#i-db" /></svg></span>
            <div>منابع داده<div class="card-sub">گزینه‌ها از فهرست ثابت، فایل Excel/CSV، رکوردهای یک قالب یا API خارجی خوانده می‌شوند.</div></div>
        </div>
    </header>

    <div class="toolbar">
        <form acl-res="Mapper.DataSources" acl-act="View" method="get" asp-action="Index" role="search">
            <input type="hidden" name="pageSize" value="@result.PageSize" />
            <div class="input-wrap">
                <svg class="ico"><use href="#i-search" /></svg>
                <input class="input" type="search" name="search" value="@filter.Search" placeholder="جستجو بر اساس کد یا نام…" aria-label="جستجو در منابع داده" autocomplete="off" />
            </div>
            <button type="submit" class="btn btn-ghost"><svg class="ico"><use href="#i-search" /></svg>جستجو</button>
            @if (searching)
            {
                <a acl-res="Mapper.DataSources" acl-act="View" class="btn btn-quiet" asp-action="Index" asp-route-pageSize="@result.PageSize"><svg class="ico"><use href="#i-x" /></svg>پاک کردن فیلتر</a>
            }
        </form>
    </div>

    @if (result.Items.Count == 0)
    {
        <div class="empty">
            @if (searching)
            {
                <p>منبع داده‌ای با «@filter.Search» پیدا نشد.</p>
                <a acl-res="Mapper.DataSources" acl-act="View" class="btn btn-ghost btn-sm" style="margin-top:.8rem" asp-action="Index" asp-route-pageSize="@result.PageSize">پاک کردن فیلتر</a>
            }
            else
            {
                <p>هنوز منبع داده‌ای ساخته نشده است؛ یک منبع بسازید تا فیلدهای قالب گزینه‌هایشان را از آن بگیرند.</p>
                <a acl-res="Mapper.DataSources" acl-act="Create" class="btn btn-primary btn-sm" style="margin-top:.8rem" asp-action="Create" data-modal><svg class="ico"><use href="#i-plus" /></svg>ساخت اولین منبع داده</a>
            }
        </div>
    }
    else
    {
        <div class="tbl-wrap">
            <table class="tbl">
                <thead>
                    <tr><th>منبع داده</th><th>نوع</th><th>وضعیت</th><th>ایجاد</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var d in result.Items)
                    {
                        <tr>
                            <td>
                                <a acl-res="Mapper.DataSources" acl-act="View" class="cell-main" asp-action="Detail" asp-route-id="@d.Id">@d.Name</a>
                                <div class="code">@d.Code</div>
                            </td>
                            <td><span class="tag @DashboardUi.Tone(d.SourceType)"><svg class="ico" style="width:.8rem;height:.8rem"><use href="#@DashboardUi.Icon(d.SourceType)" /></svg>@d.SourceType.ToLabel()</span></td>
                            <td><span class="badge @(d.IsActive ? "st-active" : "st-inactive")">@(d.IsActive ? "فعال" : "غیرفعال")</span></td>
                            <td class="cell-sub nums">@d.CreatedAt.ToJalali().ToPersianDigits()</td>
                            <td>
                                <div class="row-actions">
                                    <a acl-res="Mapper.DataSources" acl-act="View" class="icon-btn sm primary" asp-action="Detail" asp-route-id="@d.Id" title="جزئیات و گزینه‌ها" aria-label="جزئیات @d.Name"><svg class="ico"><use href="#i-eye" /></svg></a>
                                    <a acl-res="Mapper.DataSources" acl-act="Edit" class="icon-btn sm" asp-action="Edit" asp-route-id="@d.Id" asp-route-returnUrl="@here" data-modal title="ویرایش" aria-label="ویرایش @d.Name"><svg class="ico"><use href="#i-edit" /></svg></a>
                                    <form acl-res="Mapper.DataSources" acl-act="Edit" asp-action="SetActive" method="post" style="display:contents">
                                        <input type="hidden" name="id" value="@d.Id" />
                                        <input type="hidden" name="isActive" value="@((!d.IsActive).ToString().ToLowerInvariant())" />
                                        <button type="submit" class="icon-btn sm" title="@(d.IsActive ? "غیرفعال‌سازی" : "فعال‌سازی")" aria-label="@(d.IsActive ? "غیرفعال‌سازی" : "فعال‌سازی") @d.Name"><svg class="ico"><use href="#@(d.IsActive ? "i-x" : "i-check")" /></svg></button>
                                    </form>
                                    <button class="icon-btn sm danger" type="button" data-delete-id="@d.Id" data-delete-name="@d.Name" title="حذف" aria-label="حذف @d.Name"><svg class="ico"><use href="#i-trash" /></svg></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (result.TotalCount > 0)
    {
        <footer class="card-foot">
            <span>@from.ToPersianNumber() تا @to.ToPersianNumber() از @result.TotalCount.ToPersianNumber()</span>

            <nav class="pager" aria-label="صفحه‌بندی">
                @if (result.HasPrevious)
                {
                    <a acl-res="Mapper.DataSources" acl-act="View" asp-action="Index" asp-route-search="@filter.Search" asp-route-pageSize="@result.PageSize" asp-route-page="@(result.Page - 1)" rel="prev" aria-label="صفحه قبل"><svg class="ico"><use href="#i-chev-right" /></svg></a>
                }
                else
                {
                    <span aria-disabled="true"><svg class="ico"><use href="#i-chev-right" /></svg></span>
                }
                <span class="pager-now" aria-current="page">صفحه @result.Page.ToPersianNumber() از @Math.Max(1, result.TotalPages).ToPersianNumber()</span>
                @if (result.HasNext)
                {
                    <a acl-res="Mapper.DataSources" acl-act="View" asp-action="Index" asp-route-search="@filter.Search" asp-route-pageSize="@result.PageSize" asp-route-page="@(result.Page + 1)" rel="next" aria-label="صفحه بعد"><svg class="ico"><use href="#i-chev-left" /></svg></a>
                }
                else
                {
                    <span aria-disabled="true"><svg class="ico"><use href="#i-chev-left" /></svg></span>
                }
            </nav>

            <form acl-res="Mapper.DataSources" acl-act="View" method="get" asp-action="Index" class="page-size">
                <input type="hidden" name="search" value="@filter.Search" />
                <label for="pageSize">ردیف در صفحه</label>
                <select class="select" id="pageSize" name="pageSize" onchange="this.form.submit()">
                    @foreach (var size in pageSizes)
                    {
                        <option value="@size" selected="@(result.PageSize == size)">@size.ToPersianNumber()</option>
                    }
                </select>
            </form>
        </footer>
    }
</article>

<partial name="_DeleteModal" />

@section Scripts {
    <script src="~/js/confirm-delete.js" asp-append-version="true"></script>
}
