@model Borc.DataMapper.Web.ViewModels.DataSources.DataSourceIndexViewModel
@using Borc.DataMapper.Web.ViewModels.DataSources
@{
    ViewData["Title"] = "منابع داده";

    var result = Model.Result;
    var filter = Model.Filter;

    var errors = ViewData.ModelState.Values
        .SelectMany(v => v.Errors)
        .Select(e => e.ErrorMessage)
        .Where(m => !string.IsNullOrWhiteSpace(m))
        .ToList();

    var from = result.TotalCount == 0 ? 0 : (result.Page - 1) * result.PageSize + 1;
    var to = Math.Min(result.Page * result.PageSize, result.TotalCount);
    var pageSizes = new[] { 10, 20, 50, 100 };
}

<div class="panel card">
    <div class="panel-header">
        <h2>منابع داده</h2>

        <div class="summary-stats">
            <span>کل: <b>@result.TotalCount</b></span>
            @if (result.TotalCount > 0)
            {
                <span>نمایش: <b>@from</b> تا <b>@to</b></span>
            }
        </div>

        <a asp-action="Create" class="btn primary">+ منبع داده جدید</a>
    </div>

    @if (errors.Count > 0)
    {
        <div class="status error show">@string.Join(" — ", errors)</div>
    }

    <form method="get" asp-action="Index">
        <input type="hidden" name="pageSize" value="@result.PageSize" />

        <div class="form-group">
            <label for="dsSearch">جستجو (بر اساس کد یا نام):</label>
            <input type="text" id="dsSearch" name="search" value="@filter.Search"
                   placeholder="جستجو در منابع داده..." autocomplete="off">
        </div>

        <div class="actions">
            <button type="submit" class="btn primary">جستجو</button>
            <a asp-action="Index" asp-route-pageSize="@result.PageSize" class="btn ghost">پاکسازی فیلتر</a>
        </div>
    </form>
</div>

<div class="panel card">
    <div class="tscroll results-table-container">
        <table class="results-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>کد</th>
                    <th>نام</th>
                    <th>نوع</th>
                    <th>وضعیت</th>
                    <th>تاریخ ایجاد</th>
                    <th>عملیات</th>
                </tr>
            </thead>
            <tbody>
            @if (result.Items.Count == 0)
            {
                <tr>
                    <td colspan="7" class="entries-empty">
                        @(string.IsNullOrWhiteSpace(filter.Search)
                            ? "هنوز منبع داده‌ای ثبت نشده است."
                            : "منبع داده‌ای با این مشخصات پیدا نشد.")
                    </td>
                </tr>
            }
            else
            {
                foreach (var d in result.Items)
                {
                    <tr>
                        <td>@d.Id</td>
                        <td><code dir="ltr" style="font-family:var(--mono)">@d.Code</code></td>
                        <td>@d.Name</td>
                        <td><span class="mode-badge">@d.SourceType.ToLabel()</span></td>
                        <td><span class="mode-badge">@(d.IsActive ? "فعال" : "غیرفعال")</span></td>
                        <td dir="ltr">@d.CreatedAt.ToJalali()</td>
                        <td>
                            <div class="row-actions">
                                <a asp-action="Edit" asp-route-id="@d.Id" class="btn primary low-padding"
                                   title="ویرایش" aria-label="ویرایش">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2"
                                         stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M12 20h9" />
                                        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z" />
                                    </svg>
                                </a>

                                <form asp-action="SetActive" method="post" style="display:inline">
                                    <input type="hidden" name="id" value="@d.Id" />
                                    <input type="hidden" name="isActive" value="@((!d.IsActive).ToString().ToLowerInvariant())" />
                                    <button type="submit" class="btn ghost low-padding">
                                        @(d.IsActive ? "غیرفعال‌سازی" : "فعال‌سازی")
                                    </button>
                                </form>

                                <button type="button" class="btn danger low-padding"
                                        title="حذف" aria-label="حذف"
                                        data-delete-id="@d.Id" data-delete-name="@d.Name">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2"
                                         stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="3 6 5 6 21 6" />
                                        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                                        <path d="M10 11v6" />
                                        <path d="M14 11v6" />
                                        <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" />
                                    </svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>

    <div class="pagination">
        @if (result.HasPrevious)
        {
            <a class="btn ghost" asp-action="Index" asp-route-search="@filter.Search"
               asp-route-pageSize="@result.PageSize" asp-route-page="@(result.Page - 1)">قبلی</a>
        }
        else
        {
            <button type="button" class="btn ghost" disabled>قبلی</button>
        }

        <span>صفحه @result.Page از @Math.Max(1, result.TotalPages)</span>

        @if (result.HasNext)
        {
            <a class="btn ghost" asp-action="Index" asp-route-search="@filter.Search"
               asp-route-pageSize="@result.PageSize" asp-route-page="@(result.Page + 1)">بعدی</a>
        }
        else
        {
            <button type="button" class="btn ghost" disabled>بعدی</button>
        }

        <form method="get" asp-action="Index" style="display:inline">
            <input type="hidden" name="search" value="@filter.Search" />
            <label class="rpp-label">ردیف در صفحه:
                <select name="pageSize" onchange="this.form.submit()">
                    @foreach (var size in pageSizes)
                    {
                        <option value="@size" selected="@(result.PageSize == size)">@size</option>
                    }
                </select>
            </label>
        </form>
    </div>
</div>

<partial name="_DeleteModal" />

@section Scripts {
    <script src="~/js/confirm-delete.js" asp-append-version="true"></script>
}
