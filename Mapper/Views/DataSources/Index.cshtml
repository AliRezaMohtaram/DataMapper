@model Borc.DataMapper.Web.ViewModels.DataSources.DataSourceIndexViewModel
@using Borc.DataMapper.Web.ViewModels
@using Borc.DataMapper.Web.ViewModels.DataSources
@{
    ViewData["Title"] = "منابع داده";

    var result = Model.Result;
    var filter = Model.Filter;
    var searching = !string.IsNullOrWhiteSpace(filter.Search);

    var errors = ViewData.ModelState.Values
        .SelectMany(v => v.Errors)
        .Select(e => e.ErrorMessage)
        .Where(m => !string.IsNullOrWhiteSpace(m))
        .ToList();

    var from = result.TotalCount == 0 ? 0 : (result.Page - 1) * result.PageSize + 1;
    var to = Math.Min(result.Page * result.PageSize, result.TotalCount);
    var pageSizes = new[] { 10, 20, 50, 100 };
}

@section Styles {
    <link rel="stylesheet" href="~/css/vx.css" asp-append-version="true" />
}

<div class="vx">

    <header class="vx-head">
        <div>
            <h1 class="vx-title">منابع داده</h1>
            <p class="vx-sub">گزینه‌های فیلدهای قالب از فایل Excel/CSV، قالب‌های داخلی یا API خارجی تأمین می‌شود.</p>
        </div>
        <a asp-action="Create" class="vx-btn vx-btn--primary">منبع داده جدید</a>
    </header>

    @if (errors.Count > 0)
    {
        <div class="vx-alert" role="alert">@string.Join(" — ", errors)</div>
    }

    <section class="vx-card" aria-label="فهرست منابع داده">

        <div class="vx-toolbar">
            <form method="get" asp-action="Index" role="search">
                <input type="hidden" name="pageSize" value="@result.PageSize" />

                <div class="vx-search">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
                    </svg>
                    <label for="dsSearch" class="sr-only" style="position:absolute;inline-size:1px;block-size:1px;overflow:hidden;clip-path:inset(50%)">جستجو بر اساس کد یا نام</label>
                    <input type="search" id="dsSearch" name="search" value="@filter.Search" class="vx-input"
                           placeholder="جستجو بر اساس کد یا نام…" autocomplete="off" spellcheck="false" />
                </div>

                <button type="submit" class="vx-btn">جستجو</button>

                @if (searching)
                {
                    <a asp-action="Index" asp-route-pageSize="@result.PageSize" class="vx-btn">پاک کردن فیلتر</a>
                }
            </form>
        </div>

        @if (result.Items.Count == 0)
        {
            <div class="vx-empty">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <ellipse cx="12" cy="5" rx="8" ry="3" />
                    <path d="M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5" />
                    <path d="M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3" />
                </svg>
                @if (searching)
                {
                    <strong>نتیجه‌ای پیدا نشد</strong>
                    <p>منبع داده‌ای با «@filter.Search» وجود ندارد. عبارت دیگری را امتحان کنید یا فیلتر را پاک کنید.</p>
                    <a asp-action="Index" asp-route-pageSize="@result.PageSize" class="vx-btn">پاک کردن فیلتر</a>
                }
                else
                {
                    <strong>هنوز منبع داده‌ای ندارید</strong>
                    <p>یک منبع داده بسازید تا فیلدهای قالب بتوانند گزینه‌هایشان را از آن بگیرند.</p>
                    <a asp-action="Create" class="vx-btn vx-btn--primary">ساخت اولین منبع داده</a>
                }
            </div>
        }
        else
        {
            <div class="vx-scroll">
                <table class="vx-table">
                    <thead>
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">نام</th>
                            <th scope="col">کد</th>
                            <th scope="col">نوع</th>
                            <th scope="col">وضعیت</th>
                            <th scope="col">تاریخ ایجاد</th>
                            <th scope="col"><span class="sr-only" style="position:absolute;inline-size:1px;block-size:1px;overflow:hidden;clip-path:inset(50%)">عملیات</span></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var d in result.Items)
                    {
                        <tr>
                            <td class="vx-num">@d.Id</td>
                            <td><a asp-action="Detail" asp-route-id="@d.Id" class="vx-link">@d.Name</a></td>
                            <td data-label="کد"><span class="vx-code">@d.Code</span></td>
                            <td data-label="نوع"><span class="vx-tag">@d.SourceType.ToLabel()</span></td>
                            <td data-label="وضعیت">
                                <span class="vx-status @(d.IsActive ? "vx-status--on" : "")">@(d.IsActive ? "فعال" : "غیرفعال")</span>
                            </td>
                            <td data-label="ایجاد" class="vx-muted" dir="ltr" style="text-align:start">@d.CreatedAt.ToJalali()</td>
                            <td class="vx-end">
                                <div class="vx-actions">
                                    <a asp-action="Edit" asp-route-id="@d.Id" class="vx-btn vx-btn--icon"
                                       title="ویرایش @d.Name" aria-label="ویرایش @d.Name">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M12 20h9" />
                                            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z" />
                                        </svg>
                                    </a>

                                    <form asp-action="SetActive" method="post">
                                        <input type="hidden" name="id" value="@d.Id" />
                                        <input type="hidden" name="isActive" value="@((!d.IsActive).ToString().ToLowerInvariant())" />
                                        <button type="submit" class="vx-btn">@(d.IsActive ? "غیرفعال‌سازی" : "فعال‌سازی")</button>
                                    </form>

                                    <button type="button" class="vx-btn vx-btn--icon vx-btn--danger"
                                            title="حذف @d.Name" aria-label="حذف @d.Name"
                                            data-delete-id="@d.Id" data-delete-name="@d.Name">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <polyline points="3 6 5 6 21 6" />
                                            <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                                            <path d="M10 11v6" /><path d="M14 11v6" />
                                            <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" />
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <footer class="vx-foot">
                <span>@from تا @to از @result.TotalCount</span>

                <nav class="vx-pager" aria-label="صفحه‌بندی">
                    @if (result.HasPrevious)
                    {
                        <a class="vx-btn" asp-action="Index" asp-route-search="@filter.Search"
                           asp-route-pageSize="@result.PageSize" asp-route-page="@(result.Page - 1)" rel="prev">قبلی</a>
                    }
                    else
                    {
                        <span class="vx-btn" aria-disabled="true">قبلی</span>
                    }

                    <span aria-current="page">صفحه @result.Page از @Math.Max(1, result.TotalPages)</span>

                    @if (result.HasNext)
                    {
                        <a class="vx-btn" asp-action="Index" asp-route-search="@filter.Search"
                           asp-route-pageSize="@result.PageSize" asp-route-page="@(result.Page + 1)" rel="next">بعدی</a>
                    }
                    else
                    {
                        <span class="vx-btn" aria-disabled="true">بعدی</span>
                    }
                </nav>

                <form method="get" asp-action="Index">
                    <input type="hidden" name="search" value="@filter.Search" />
                    <label>ردیف در صفحه
                        <select name="pageSize" class="vx-select" onchange="this.form.submit()">
                            @foreach (var size in pageSizes)
                            {
                                <option value="@size" selected="@(result.PageSize == size)">@size</option>
                            }
                        </select>
                    </label>
                </form>
            </footer>
        }
    </section>
</div>

<partial name="_DeleteModal" />

@section Scripts {
    <script src="~/js/confirm-delete.js" asp-append-version="true"></script>
}
