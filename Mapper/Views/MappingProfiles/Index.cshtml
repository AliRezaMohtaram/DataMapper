@model Borc.DataMapper.Web.ViewModels.MappingProfiles.MappingProfileIndexViewModel
@using Borc.DataMapper.Web.ViewModels.MappingProfiles
@using Borc.DataMapper.Domain.Mappings
@{
    ViewData["Title"] = "پروفایل‌های نگاشت";

    var result = Model.Result;
    var filter = Model.Filter;
    var filtering = !string.IsNullOrWhiteSpace(filter.Search) || filter.TemplateVersionId.HasValue;

    var errors = ViewData.ModelState.Values
        .SelectMany(v => v.Errors)
        .Select(e => e.ErrorMessage)
        .Where(m => !string.IsNullOrWhiteSpace(m))
        .ToList();

    var from = result.TotalCount == 0 ? 0 : (result.Page - 1) * result.PageSize + 1;
    var to = Math.Min(result.Page * result.PageSize, result.TotalCount);
    var pageSizes = new[] { 10, 20, 50, 100 };

    ViewData["Subtitle"] = $"{result.TotalCount.ToPersianNumber()} پروفایل · نگاشت ذخیره‌شدهٔ ستون‌های فایل به فیلدهای قالب";
}

@section TopbarActions {
    <a class="btn btn-soft" asp-action="Create" asp-route-templateVersionId="@filter.TemplateVersionId" data-modal><svg class="ico"><use href="#i-plus" /></svg><span class="lbl">پروفایل جدید</span></a>
}

@if (errors.Count > 0)
{
    <div class="callout tone-danger" role="alert" style="margin-bottom:1rem">
        <svg class="ico"><use href="#i-alert" /></svg><div>@string.Join(" — ", errors)</div>
    </div>
}

<article class="card rise">
    <header class="card-head">
        <div class="card-title">
            <span class="card-ico"><svg class="ico"><use href="#i-map" /></svg></span>
            <div>پروفایل‌های نگاشت<div class="card-sub">در ایمپورت، پروفایل ستون‌های فایل را خودکار به فیلدها وصل می‌کند.</div></div>
        </div>
    </header>

    <div class="toolbar">
        <form method="get" asp-action="Index" role="search">
            <input type="hidden" name="pageSize" value="@result.PageSize" />
            <input type="hidden" name="templateVersionId" value="@filter.TemplateVersionId" />
            <div class="input-wrap">
                <svg class="ico"><use href="#i-search" /></svg>
                <input class="input" type="search" name="search" value="@filter.Search" placeholder="جستجو در نام پروفایل یا قالب…" aria-label="جستجو در پروفایل‌ها" autocomplete="off" />
            </div>
            <button type="submit" class="btn btn-ghost"><svg class="ico"><use href="#i-search" /></svg>جستجو</button>
            @if (filtering)
            {
                <a class="btn btn-quiet" asp-action="Index" asp-route-pageSize="@result.PageSize"><svg class="ico"><use href="#i-x" /></svg>پاک کردن فیلتر</a>
            }
        </form>
    </div>

    @if (result.Items.Count == 0)
    {
        <div class="empty">
            @if (filtering)
            {
                <p>پروفایلی با این مشخصات پیدا نشد.</p>
            }
            else
            {
                <p>هنوز پروفایل نگاشتی ساخته نشده است.</p>
                <p class="hint" style="margin-top:.3rem">می‌توانید پروفایل را دستی بسازید یا هنگام تطبیق ستون‌های یک ایمپورت، نگاشت را به‌عنوان پروفایل ذخیره کنید.</p>
                <a class="btn btn-primary btn-sm" style="margin-top:.8rem" asp-action="Create" data-modal><svg class="ico"><use href="#i-plus" /></svg>ساخت پروفایل</a>
            }
        </div>
    }
    else
    {
        <div class="tbl-wrap">
            <table class="tbl">
                <thead><tr><th>پروفایل</th><th>قالب</th><th>قاعده‌ها</th><th>وضعیت</th><th>ایجاد</th><th></th></tr></thead>
                <tbody>
                    @foreach (var p in result.Items)
                    {
                        var active = p.Status == MappingProfileStatus.Active;
                        var statusForm = $"mpStatus_{p.Id}";
                        <tr>
                            <td>
                                <a class="cell-main" asp-action="Detail" asp-route-id="@p.Id">@p.Name</a>
                                <div class="cell-sub">فایل @p.SourceType.ToLabel()</div>
                            </td>
                            <td><div class="cell-main">@p.TemplateName</div><div class="cell-sub">نسخهٔ @p.VersionNo.ToPersianNumber()</div></td>
                            <td>
                                @if (p.RuleCount > 0)
                                {
                                    <span class="tag tg-alias">@p.RuleCount.ToPersianNumber() قاعده</span>
                                }
                                else
                                {
                                    <span class="tag tg-manual">بدون قاعده</span>
                                }
                            </td>
                            <td><span class="badge @(active ? "st-active" : "st-inactive")">@p.Status.ToLabel()</span></td>
                            <td class="cell-sub nums">@p.CreatedAt.ToJalali().ToPersianDigits()</td>
                            <td>
                                <form id="@statusForm" asp-action="SetStatus" method="post" hidden>
                                    <input type="hidden" name="id" value="@p.Id" />
                                    <input type="hidden" name="isActive" value="@((!active).ToString().ToLowerInvariant())" />
                                </form>
                                <div class="row-actions">
                                    <a class="icon-btn sm primary" asp-action="Detail" asp-route-id="@p.Id" title="جزئیات و قاعده‌ها" aria-label="جزئیات @p.Name"><svg class="ico"><use href="#i-eye" /></svg></a>
                                    <a class="icon-btn sm" asp-action="Edit" asp-route-id="@p.Id" data-modal title="ویرایش" aria-label="ویرایش @p.Name"><svg class="ico"><use href="#i-edit" /></svg></a>
                                    <button class="icon-btn sm" type="submit" form="@statusForm" title="@(active ? "غیرفعال‌سازی" : "فعال‌سازی")" aria-label="@(active ? "غیرفعال‌سازی" : "فعال‌سازی") @p.Name">
                                        <svg class="ico"><use href="#@(active ? "i-x" : "i-check")" /></svg>
                                    </button>
                                    <button class="icon-btn sm danger" type="button" data-delete-id="@p.Id" data-delete-name="@p.Name" title="حذف" aria-label="حذف @p.Name"><svg class="ico"><use href="#i-trash" /></svg></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (result.TotalCount > 0)
    {
        <footer class="card-foot">
            <span>@from.ToPersianNumber() تا @to.ToPersianNumber() از @result.TotalCount.ToPersianNumber()</span>
            <nav class="pager" aria-label="صفحه‌بندی">
                @if (result.HasPrevious)
                {
                    <a asp-action="Index" asp-route-search="@filter.Search" asp-route-templateVersionId="@filter.TemplateVersionId" asp-route-pageSize="@result.PageSize" asp-route-page="@(result.Page - 1)" rel="prev" aria-label="صفحه قبل"><svg class="ico"><use href="#i-chev-right" /></svg></a>
                }
                else
                {
                    <span aria-disabled="true"><svg class="ico"><use href="#i-chev-right" /></svg></span>
                }
                <span class="pager-now" aria-current="page">صفحه @result.Page.ToPersianNumber() از @Math.Max(1, result.TotalPages).ToPersianNumber()</span>
                @if (result.HasNext)
                {
                    <a asp-action="Index" asp-route-search="@filter.Search" asp-route-templateVersionId="@filter.TemplateVersionId" asp-route-pageSize="@result.PageSize" asp-route-page="@(result.Page + 1)" rel="next" aria-label="صفحه بعد"><svg class="ico"><use href="#i-chev-left" /></svg></a>
                }
                else
                {
                    <span aria-disabled="true"><svg class="ico"><use href="#i-chev-left" /></svg></span>
                }
            </nav>
            <form method="get" asp-action="Index" class="page-size">
                <input type="hidden" name="search" value="@filter.Search" />
                <input type="hidden" name="templateVersionId" value="@filter.TemplateVersionId" />
                <label for="pageSize">ردیف در صفحه</label>
                <select class="select" id="pageSize" name="pageSize" onchange="this.form.submit()">
                    @foreach (var size in pageSizes)
                    {
                        <option value="@size" selected="@(result.PageSize == size)">@size.ToPersianNumber()</option>
                    }
                </select>
            </form>
        </footer>
    }
</article>

<partial name="_DeleteModal" />

@section Scripts {
    <script src="~/js/confirm-delete.js" asp-append-version="true"></script>
}
