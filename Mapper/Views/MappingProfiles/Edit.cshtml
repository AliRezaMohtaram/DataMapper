@model Borc.DataMapper.Application.MappingProfiles.UpdateMappingProfile.UpdateMappingProfileCommand
@{
    ViewData["Title"] = "ویرایش پروفایل نگاشت";

    var modelErrors = ViewData.ModelState
        .Where(kv => string.IsNullOrEmpty(kv.Key))
        .SelectMany(kv => kv.Value!.Errors)
        .Select(e => e.ErrorMessage)
        .Where(m => !string.IsNullOrWhiteSpace(m))
        .ToList();
}

<div class="panel card">
    <div class="panel-header">
        <h2>ویرایش پروفایل نگاشت</h2>
    </div>

    @if (modelErrors.Count > 0)
    {
        <div class="status error show">@string.Join(" — ", modelErrors)</div>
    }

    <form asp-action="Edit" method="post">
        <input asp-for="Id" type="hidden" />

        <div class="form-group">
            <label>قالب و نسخه:</label>
            <input type="text" value="@ViewData["Target"]" disabled />
            <div class="hint">نسخه پس از ساخت پروفایل قابل تغییر نیست.</div>
        </div>

        <div class="form-group">
            <label asp-for="Name">نام پروفایل:</label>
            <input asp-for="Name" autocomplete="off" />
            <span asp-validation-for="Name" style="color:var(--danger);font-size:12px"></span>
        </div>

        <div class="form-group">
            <label asp-for="SourceType">نوع فایل مبدأ:</label>
            <select asp-for="SourceType">
                <option value="@Borc.DataMapper.Domain.Mappings.ImportSourceType.Excel" selected>Excel (xlsx)</option>
            </select>
        </div>

        <div class="actions">
            <button type="submit" class="btn primary">ذخیره تغییرات</button>
            <a asp-action="Detail" asp-route-id="@Model.Id" class="btn ghost">انصراف</a>
        </div>
    </form>
</div>
