@model Borc.DataMapper.Application.MappingProfiles.GetMappingProfile.MappingProfileDetailDto
@using Borc.DataMapper.Web.ViewModels.MappingProfiles
@using Borc.DataMapper.Web.ViewModels.Imports
@using Borc.DataMapper.Web.ViewModels.Dashboard
@using Borc.DataMapper.Domain.Mappings
@using System.Globalization
@{
    ViewData["Title"] = Model.Name;
    ViewData["Subtitle"] = $"پروفایل نگاشت · {Model.TemplateName} · نسخهٔ {Model.VersionNo.ToPersianNumber()}";

    var isActive = Model.Status == MappingProfileStatus.Active;
    var coverage = Model.FieldCount == 0 ? 0 : (int)Math.Round(100.0 * Model.Rules.Count / Model.FieldCount);
    var deleteRuleUrl = Url.Action("DeleteRule", "MappingProfiles");
}

@section TopbarActions {
    <a class="btn btn-ghost" asp-action="Index"><svg class="ico"><use href="#i-chev-right" /></svg><span class="lbl">همه پروفایل‌ها</span></a>
}

<div class="split">
    <section class="stack" style="min-width:0">
        @if (Model.UnmappedRequiredFields.Count > 0)
        {
            <div class="callout tone-warning rise">
                <svg class="ico"><use href="#i-alert" /></svg>
                <div>
                    <b>@Model.UnmappedRequiredFields.Count.ToPersianNumber() فیلد الزامی</b> قاعده ندارد؛ در ایمپورت باید دستی نگاشت شوند:
                    <div class="req-list" style="margin-top:.45rem">
                        @foreach (var f in Model.UnmappedRequiredFields)
                        {
                            <span class="tag tone-warning">@f</span>
                        }
                    </div>
                </div>
            </div>
        }

        <article class="card rise" style="--i:1">
            <header class="card-head">
                <div class="card-title">
                    <span class="card-ico"><svg class="ico"><use href="#i-arrow-left" /></svg></span>
                    <div>قاعده‌های نگاشت<div class="card-sub">هر قاعده: عنوان ستون در فایل ← فیلد قالب</div></div>
                </div>
                <a class="btn btn-primary btn-sm" asp-action="AddRule" asp-route-profileId="@Model.Id" data-modal><svg class="ico"><use href="#i-plus" /></svg>قاعدهٔ جدید</a>
            </header>

            @if (Model.Rules.Count == 0)
            {
                <div class="empty">
                    <p>هنوز قاعده‌ای ثبت نشده است.</p>
                    <p class="hint" style="margin-top:.3rem">قاعده‌ها را دستی اضافه کنید یا هنگام تطبیق ستون‌های یک ایمپورت، نگاشت را به‌عنوان پروفایل ذخیره کنید.</p>
                </div>
            }
            else
            {
                <div class="tbl-wrap">
                    <table class="tbl">
                        <thead><tr><th>#</th><th>ستون فایل</th><th></th><th>فیلد قالب</th><th>روش</th><th>اطمینان</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var r in Model.Rules)
                            {
                                <tr>
                                    <td class="cell-sub nums">@r.SortOrder.ToPersianNumber()</td>
                                    <td><span class="code-chip">@r.SourceColumn</span></td>
                                    <td><svg class="ico faint"><use href="#i-arrow-left" /></svg></td>
                                    <td><a class="cell-main" asp-action="EditRule" asp-route-profileId="@Model.Id" asp-route-id="@r.Id" data-modal>@r.FieldLabel</a><div class="code" style="font-size:.72rem">@r.FieldKey</div></td>
                                    <td><span class="tag @r.Method.TagClass()">@r.Method.ToLabel()</span></td>
                                    <td>
                                        @if (r.Confidence is decimal c)
                                        {
                                            <div class="conf" style="min-width:6.5rem">
                                                <span class="meter @DashboardUi.CoverageTone((int)c)"><i style="width:@(((double)c).ToString("0.##", CultureInfo.InvariantCulture))%"></i></span>
                                                <span>@(((int)c).ToPersianNumber())٪</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="cell-sub">—</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="row-actions">
                                            <a class="icon-btn sm" asp-action="EditRule" asp-route-profileId="@Model.Id" asp-route-id="@r.Id" data-modal title="ویرایش" aria-label="ویرایش قاعدهٔ @r.SourceColumn"><svg class="ico"><use href="#i-edit" /></svg></a>
                                            <button class="icon-btn sm danger" type="button" title="حذف" aria-label="حذف قاعدهٔ @r.SourceColumn"
                                                    data-delete-id="@r.Id" data-delete-name="قاعدهٔ «@r.SourceColumn»" data-delete-url="@deleteRuleUrl"><svg class="ico"><use href="#i-trash" /></svg></button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </article>
    </section>

    <aside class="split-side">
        <article class="card rise" style="--i:2">
            <div class="card-body">
                <div class="row" style="justify-content:space-between;align-items:flex-start">
                    <div class="hero-title">@Model.Name</div>
                    <span class="badge @(isActive ? "st-active" : "st-inactive")">@Model.Status.ToLabel()</span>
                </div>
                <a class="link-btn" asp-controller="Templates" asp-action="Detail" asp-route-id="@Model.TemplateId">@Model.TemplateName</a>

                <div style="margin-top:1rem">
                    <div class="meter-head"><b>پوشش فیلدها</b><span>@Model.Rules.Count.ToPersianNumber() از @Model.FieldCount.ToPersianNumber()</span></div>
                    <div class="meter @DashboardUi.CoverageTone(coverage)"><i style="width:@coverage%"></i></div>
                </div>

                <dl class="dl stacked" style="margin-top:1rem">
                    <div>
                        <dt>نسخهٔ قالب</dt>
                        <dd>
                            <a class="link-btn" asp-controller="TemplateVersions" asp-action="Detail" asp-route-id="@Model.TemplateVersionId">نسخهٔ @Model.VersionNo.ToPersianNumber()</a>
                            <span class="badge @Model.VersionStatus.BadgeClass()">@Model.VersionStatus.ToLabel()</span>
                        </dd>
                    </div>
                    <div><dt>نوع فایل مبدأ</dt><dd>@Model.SourceType.ToLabel()</dd></div>
                    <div><dt>ایمپورت‌های انجام‌شده</dt><dd class="nums">@Model.BatchCount.ToPersianNumber()</dd></div>
                    <div><dt>تاریخ ایجاد</dt><dd class="nums">@Model.CreatedAt.ToJalali().ToPersianDigits()</dd></div>
                    <div><dt>آخرین ویرایش</dt><dd class="nums">@(Model.UpdatedAt.HasValue ? Model.UpdatedAt.ToJalali().ToPersianDigits() : "—")</dd></div>
                </dl>
            </div>

            <div class="card-foot" style="display:block">
                <div class="action-stack">
                    @if (isActive && Model.VersionStatus == TemplateVersionStatus.Published)
                    {
                        <a class="btn btn-primary" asp-controller="Imports" asp-action="Upload" asp-route-versionId="@Model.TemplateVersionId" asp-route-profileId="@Model.Id" data-modal><svg class="ico"><use href="#i-upload" /></svg>ایمپورت با این پروفایل</a>
                    }
                    <a class="btn btn-ghost" asp-action="Edit" asp-route-id="@Model.Id" data-modal><svg class="ico"><use href="#i-edit" /></svg>ویرایش پروفایل</a>
                    <form asp-action="SetStatus" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="isActive" value="@((!isActive).ToString().ToLowerInvariant())" />
                        <input type="hidden" name="returnTo" value="detail" />
                        <button type="submit" class="btn btn-ghost"><svg class="ico"><use href="#@(isActive ? "i-x" : "i-check")" /></svg>@(isActive ? "غیرفعال‌سازی" : "فعال‌سازی")</button>
                    </form>
                    <div class="dd-sep"></div>
                    <button type="button" class="btn btn-danger-soft" data-delete-id="@Model.Id" data-delete-name="@Model.Name"
                            data-delete-url="@Url.Action("Delete", "MappingProfiles")"><svg class="ico"><use href="#i-trash" /></svg>حذف پروفایل</button>
                </div>
            </div>
        </article>
    </aside>
</div>

<partial name="_DeleteModal" />

@section Scripts {
    <script src="~/js/confirm-delete.js" asp-append-version="true"></script>
}
