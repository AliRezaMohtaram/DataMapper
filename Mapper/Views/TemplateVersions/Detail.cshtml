@model Borc.DataMapper.Application.TemplateVersions.GetTemplateVersion.TemplateVersionDetailDto
@using Borc.DataMapper.Web.ViewModels.Dashboard
@{
    ViewData["Title"] = $"{Model.TemplateName} — نسخهٔ {Model.VersionNo.ToPersianNumber()}";
    ViewData["Subtitle"] = $"قالب {Model.TemplateCode} · {Model.Fields.Count.ToPersianNumber()} فیلد";

    var isDraft = Model.Status == TemplateVersionStatus.Draft;
    var isArchived = Model.Status == TemplateVersionStatus.Archived;
    var deleteFieldUrl = Url.Action("Delete", "TemplateFields");
    var required = Model.Fields.Count(f => f.IsRequired);
    var withAlias = Model.Fields.Count(f => f.AliasCount > 0);
}

@section TopbarActions {
    <a acl-res="Mapper.Templates" acl-act="View" class="btn btn-ghost" asp-controller="Templates" asp-action="Detail" asp-route-id="@Model.TemplateId"><svg class="ico"><use href="#i-chev-right" /></svg><span class="lbl">بازگشت به قالب</span></a>
}

@if (!isDraft)
{
    <div class="callout @(isArchived ? "tone-violet" : "tone-info")" style="margin-bottom:1rem">
        <svg class="ico"><use href="#i-info" /></svg>
        <div>
            این نسخه @(isArchived ? "بایگانی شده" : "منتشر شده") و فیلدهایش قابل تغییر نیست.
            برای تغییر ساختار، از صفحهٔ قالب یک <b>نسخهٔ جدید</b> بسازید؛ فیلدها، نام‌های مستعار و چیدمان آخرین نسخه در آن کپی می‌شوند.
        </div>
    </div>
}

<div class="split">

    <article class="card rise">
        <header class="card-head">
            <div class="card-title">
                <span class="card-ico"><svg class="ico"><use href="#i-list" /></svg></span>
                <div>فیلدها<div class="card-sub">@Model.Fields.Count.ToPersianNumber() فیلد · @required.ToPersianNumber() الزامی · @withAlias.ToPersianNumber() دارای نام مستعار</div></div>
            </div>
            @if (isDraft)
            {
                <a acl-res="Mapper.Templates" acl-act="Edit" class="btn btn-primary btn-sm" asp-controller="TemplateFields" asp-action="Create" asp-route-templateVersionId="@Model.Id" data-modal>
                    <svg class="ico"><use href="#i-plus" /></svg>فیلد جدید
                </a>
            }
        </header>

        @if (Model.Fields.Count == 0)
        {
            <div class="empty">
                <p>این نسخه هنوز فیلدی ندارد.</p>
                @if (isDraft)
                {
                    <a acl-res="Mapper.Templates" acl-act="Edit" class="btn btn-soft btn-sm" style="margin-top:.8rem" asp-controller="TemplateFields" asp-action="Create" asp-route-templateVersionId="@Model.Id" data-modal><svg class="ico"><use href="#i-plus" /></svg>اولین فیلد</a>
                }
            </div>
        }
        else
        {
            <div class="tbl-wrap">
                <table class="tbl">
                    <thead><tr><th>#</th><th>فیلد</th><th>نوع داده</th><th>الزامی</th><th>نام مستعار</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var f in Model.Fields)
                        {
                            <tr>
                                <td class="cell-sub nums">@f.SortOrder.ToPersianNumber()</td>
                                <td>
                                    @if (isDraft)
                                    {
                                        <a acl-res="Mapper.Templates" acl-act="Edit" class="cell-main" asp-controller="TemplateFields" asp-action="Edit" asp-route-id="@f.Id" data-modal>@f.Label</a>
                                    }
                                    else
                                    {
                                        <span class="cell-main">@f.Label</span>
                                    }
                                    <div class="code">@f.FieldKey</div>
                                </td>
                                <td><div>@f.DataType.ToLabel()</div><div class="cell-sub mono">@f.DbType</div></td>
                                <td>
                                    @if (f.IsRequired)
                                    {
                                        <span class="badge st-validating">الزامی</span>
                                    }
                                    else
                                    {
                                        <span class="cell-sub">اختیاری</span>
                                    }
                                </td>
                                <td>
                                    @if (f.AliasCount > 0)
                                    {
                                        <span class="tag tg-alias">@f.AliasCount.ToPersianNumber() نام</span>
                                    }
                                    else
                                    {
                                        <span class="cell-sub">—</span>
                                    }
                                </td>
                                <td>
                                    @if (isDraft)
                                    {
                                        <div class="row-actions">
                                            <a acl-res="Mapper.Templates" acl-act="Edit" class="icon-btn sm" asp-controller="TemplateFields" asp-action="Edit" asp-route-id="@f.Id" data-modal title="ویرایش" aria-label="ویرایش @f.FieldKey"><svg class="ico"><use href="#i-edit" /></svg></a>
                                            <button class="icon-btn sm danger" type="button" title="حذف" aria-label="حذف @f.FieldKey"
                                                    data-delete-id="@f.Id" data-delete-name="فیلد @f.FieldKey" data-delete-url="@deleteFieldUrl">
                                                <svg class="ico"><use href="#i-trash" /></svg>
                                            </button>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </article>

    <aside class="split-side">
        <article class="card rise" style="--i:1">
            <div class="card-body">
                <div class="row" style="justify-content:space-between;align-items:flex-start">
                    <div>
                        <div class="hero-title">نسخهٔ @Model.VersionNo.ToPersianNumber()</div>
                        <a acl-res="Mapper.Templates" acl-act="View" class="link-btn" asp-controller="Templates" asp-action="Detail" asp-route-id="@Model.TemplateId">@Model.TemplateName</a>
                    </div>
                    <span class="badge @Model.Status.BadgeClass()">@Model.Status.ToLabel()</span>
                </div>

                <dl class="dl stacked" style="margin-top:1rem">
                    <div><dt>کد قالب</dt><dd><span class="code">@Model.TemplateCode</span></dd></div>
                    <div><dt>تاریخ ایجاد</dt><dd class="nums">@Model.CreatedAt.ToJalali().ToPersianDigits()</dd></div>
                    <div><dt>آخرین ویرایش</dt><dd class="nums">@Model.UpdatedAt.ToJalali().ToPersianDigits()</dd></div>
                    <div><dt>تاریخ انتشار</dt><dd class="nums">@(Model.PublishedAt.HasValue ? Model.PublishedAt.ToJalali().ToPersianDigits() : "—")</dd></div>
                </dl>
            </div>

            <div class="card-foot" style="display:block">
                <div class="action-stack">
                    @if (isDraft)
                    {
                        <form acl-res="Mapper.Templates" acl-act="Approve" id="publishForm" asp-action="Publish" method="post" hidden>
                            <input type="hidden" name="id" value="@Model.Id" />
                        </form>
                        <button type="button" class="btn btn-primary" @(Model.Fields.Count == 0 ? "disabled" : null)
                                title="@(Model.Fields.Count == 0 ? "نسخهٔ بدون فیلد قابل انتشار نیست" : null)"
                                data-confirm-target="publishForm" data-confirm-title="انتشار نسخه"
                                data-confirm-message="با انتشار، نسخه تغییرناپذیر می‌شود و نسخهٔ منتشرشدهٔ قبلی این قالب بایگانی می‌شود. ادامه می‌دهید؟">
                            <svg class="ico"><use href="#i-check" /></svg>انتشار نسخه
                        </button>
                    }

                    @if (!isArchived)
                    {
                        <a acl-res="Mapper.Templates" acl-act="Edit" class="btn btn-ghost" asp-controller="TemplateLayouts" asp-action="Designer" asp-route-versionId="@Model.Id"><svg class="ico"><use href="#i-layout" /></svg>طراح چیدمان فرم</a>
                    }

                    @if (!isArchived)
                    {
                        <form acl-res="Mapper.Templates" acl-act="Approve" id="archiveForm" asp-action="Archive" method="post" hidden>
                            <input type="hidden" name="id" value="@Model.Id" />
                        </form>
                        <button type="button" class="btn btn-ghost" data-confirm-target="archiveForm" data-confirm-title="بایگانی نسخه"
                                data-confirm-message="بایگانی نسخه غیرقابل بازگشت است. ادامه می‌دهید؟">
                            <svg class="ico"><use href="#i-download" /></svg>بایگانی
                        </button>
                    }

                    @if (isDraft)
                    {
                        <div class="dd-sep"></div>
                        <button type="button" class="btn btn-danger-soft" data-delete-id="@Model.Id" data-delete-name="نسخهٔ @Model.VersionNo.ToPersianNumber()">
                            <svg class="ico"><use href="#i-trash" /></svg>حذف نسخه
                        </button>
                    }
                </div>
            </div>
        </article>
    </aside>
</div>

<partial name="_DeleteModal" />
<partial name="_ConfirmModal" />

@section Scripts {
    <script src="~/js/confirm-delete.js" asp-append-version="true"></script>
    <script src="~/js/confirm-action.js" asp-append-version="true"></script>
}
