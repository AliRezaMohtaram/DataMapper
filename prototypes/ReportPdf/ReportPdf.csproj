<Project Sdk="Microsoft.NET.Sdk">
  <!-- Prototype: the same Persian report rendered by two PDF engines (Chromium from HTML, QuestPDF). Not part of Mapper.sln. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.56.0" />
    <PackageReference Include="QuestPDF" Version="2026.8.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="fonts\*.ttf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
