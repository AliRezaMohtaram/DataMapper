<?xml version="1.0" encoding="utf-8"?>
<!--
  The OrgChart and Acl packages are kept in this repository (modules-feed/), so a pull and a build are enough:
  nothing has to be packed on the developer's machine. They are refreshed with tools/update-modules.sh.
  Source mapping pins OrgChart.* and Acl.* to that folder: nuget.org has unrelated packages with the same names
  (e.g. "Acl.Core" 3.x), which must never be picked up.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="modules" value="modules-feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="modules">
      <package pattern="OrgChart.*" />
      <package pattern="Acl.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
