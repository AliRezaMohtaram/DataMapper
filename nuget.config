<?xml version="1.0" encoding="utf-8"?>
<!--
  OrgChart and Acl packages come from the clones next to this repository until they are on a shared feed:
  ../organization (dotnet pack OrgChart.sln -c Release) and ../Acl (dotnet pack Acl.sln -c Release; pack Acl first).
  Source mapping pins OrgChart.* and Acl.* to those folders: nuget.org has unrelated packages with the same names
  (e.g. "Acl.Core" 3.x), which must never be picked up. If your clones are elsewhere, change the paths here.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="orgchart-local" value="../organization/artifacts/packages" />
    <add key="acl-local" value="../Acl/artifacts/packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="orgchart-local">
      <package pattern="OrgChart.*" />
    </packageSource>
    <packageSource key="acl-local">
      <package pattern="Acl.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
