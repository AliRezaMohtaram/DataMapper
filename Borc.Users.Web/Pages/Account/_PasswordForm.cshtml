@model Borc.Users.Web.Pages.Account.PasswordModel
<form class="modal modal-sm" method="post" asp-page="/Account/Password" data-mx-ajax novalidate>
    <div class="modal-head">
        <span class="modal-head-ico tone-primary"><svg class="ico"><use href="#i-user" /></svg></span>
        <div>
            <div class="modal-title">تغییر رمز عبور</div>
            <div class="modal-sub">رمز جدید دست‌کم ۸ حرف و یک رقم دارد.</div>
        </div>
        <a class="icon-btn plain close" href="~/" data-close aria-label="بستن"><svg class="ico"><use href="#i-x" /></svg></a>
    </div>
    <div class="modal-body">
        <partial name="_UsersFormErrors" model="Model.FormErrors" />
        <div class="field">
            <label class="label" for="Current">رمز فعلی<span class="req">*</span></label>
            <input class="input ltr" id="Current" name="Current" type="password" autocomplete="current-password" autofocus required />
        </div>
        <div class="form-grid" style="margin-top:1rem">
            <div class="field">
                <label class="label" for="NewPassword">رمز جدید<span class="req">*</span></label>
                <input class="input ltr" id="NewPassword" name="NewPassword" type="password" autocomplete="new-password" required />
            </div>
            <div class="field">
                <label class="label" for="Confirm">تکرار رمز جدید<span class="req">*</span></label>
                <input class="input ltr" id="Confirm" name="Confirm" type="password" autocomplete="new-password" required />
            </div>
        </div>
    </div>
    <div class="modal-foot">
        <span class="spacer"></span>
        <a class="btn btn-quiet" href="~/" data-close>انصراف</a>
        <button type="submit" class="btn btn-primary"><svg class="ico"><use href="#i-check" /></svg>ذخیره</button>
    </div>
</form>
