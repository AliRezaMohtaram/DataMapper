@model Borc.Users.Web.Pages.Users.PasswordModel
<form class="modal modal-sm" method="post" asp-page="/Users/Password" asp-route-id="@Model.Id" asp-route-returnUrl="@Model.ReturnUrl" data-mx-ajax novalidate>
    <div class="modal-head">
        <span class="modal-head-ico tone-warning"><svg class="ico"><use href="#i-refresh" /></svg></span>
        <div>
            <div class="modal-title">رمز جدید برای «@Model.Subject.DisplayName»</div>
            <div class="modal-sub">نشست‌های دیگر این کاربر تا یک دقیقه بعد خارج می‌شوند و قفل موقت حساب برداشته می‌شود.</div>
        </div>
        <a class="icon-btn plain close" href="@Model.BackUrl" data-close aria-label="بستن"><svg class="ico"><use href="#i-x" /></svg></a>
    </div>
    <div class="modal-body">
        <partial name="_UsersFormErrors" model="Model.FormErrors" />
        <div class="form-grid">
            <div class="field">
                <label class="label" for="NewPassword">رمز جدید<span class="req">*</span></label>
                <input class="input ltr" id="NewPassword" name="NewPassword" type="password" autocomplete="new-password" autofocus required />
            </div>
            <div class="field">
                <label class="label" for="Confirm">تکرار رمز<span class="req">*</span></label>
                <input class="input ltr" id="Confirm" name="Confirm" type="password" autocomplete="new-password" required />
            </div>
        </div>
    </div>
    <div class="modal-foot">
        <span class="spacer"></span>
        <a class="btn btn-quiet" href="@Model.BackUrl" data-close>انصراف</a>
        <button type="submit" class="btn btn-primary"><svg class="ico"><use href="#i-check" /></svg>ذخیره</button>
    </div>
</form>
